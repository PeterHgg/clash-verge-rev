+	h := withHosts(nil)(func(got *icontext.DNSContext, m *D.Msg) (*D.Msg, error) {
+		if got != ctx || m.Question[0].Name != "preferred.example." || m.Question[0].Qtype != D.TypeAAAA {
+			t.Fatalf("context/question changed: %v", m)
+		}
+		return new(D.Msg).SetReply(m), nil
+	})
+	response, err := h(ctx, request)
+	if err != nil || response.Question[0] != request.Question[0] || response.Answer[0].(*D.CNAME).Target != "preferred.example." {
+		t.Fatalf("got %v, %v", response, err)
+	}
+	setAliasHosts(t, map[string]string{"*.example": "origin.example"})
+	if _, err := h(ctx, request); !errors.Is(err, resolver.ErrHostAliasCycle) {
+		t.Fatalf("cycle got %v", err)
+	}
+}
+
+func TestHostsAliasUsesResolverPolicyAndCacheRefresh(t *testing.T) {
+	setAliasHosts(t, map[string]string{"origin.example": "preferred.example"})
+	var version, queries atomic.Int32
+	version.Store(1)
+	upstream := hostsAliasClient{exchange: func(_ context.Context, request *D.Msg) (*D.Msg, error) {
+		queries.Add(1)
+		q := request.Question[0]
+		if q.Name != "preferred.example." || q.Qtype != D.TypeA {
+			return nil, errors.New("wrong terminal query")
+		}
+		response := new(D.Msg).SetReply(request)
+		ip := netip.AddrFrom4([4]byte{192, 0, 2, byte(version.Load())})
+		response.Answer = []D.RR{&D.A{Hdr: D.RR_Header{Name: q.Name, Rrtype: D.TypeA, Class: D.ClassINET, Ttl: 60}, A: ip.AsSlice()}}
+		return response, nil
+	}}
+	policy := trie.New[[]dnsClient]()
+	if err := policy.Insert("preferred.example", []dnsClient{upstream}); err != nil {
+		t.Fatal(err)
+	}
+	r := &Resolver{
+		cache:  Config{}.newCache(),
+		policy: []dnsPolicy{domainTriePolicy{policy}},
+		main: []dnsClient{hostsAliasClient{exchange: func(context.Context, *D.Msg) (*D.Msg, error) {
+			return nil, errors.New("terminal policy was not preserved")
+		}}},
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	lookup := func() netip.Addr {
+		t.Helper()
+		ips, err := resolver.LookupIPv4WithResolver(ctx, "origin.example", r)
+		if err != nil || len(ips) != 1 {
+			t.Fatalf("lookup got %v, %v", ips, err)
+		}
+		return ips[0]
+	}
+	first, second := netip.MustParseAddr("192.0.2.1"), netip.MustParseAddr("192.0.2.2")
+	if ip := lookup(); ip != first {
+		t.Fatalf("initial IP %v", ip)
+	}
+	version.Store(2)
+	if ip := lookup(); ip != first || queries.Load() != 1 {
+		t.Fatalf("valid cache not retained: %v, queries=%d", ip, queries.Load())
+	}
+	q := new(D.Msg).SetQuestion("preferred.example.", D.TypeA).Question[0]
+	cached, _, hit := r.cache.GetWithExpire(q.String())
+	if !hit {
+		t.Fatal("terminal-domain response was not cached")
+	}
+	r.cache.SetWithExpire(q.String(), cached, time.Now().Add(-time.Second))
+	if ip := lookup(); ip != first {
+		t.Fatalf("expected existing stale-while-refresh response, got %v", ip)
+	}
+	ticker := time.NewTicker(time.Millisecond)
+	defer ticker.Stop()
+	for {
+		if ip := lookup(); ip == second {
+			return
+		}
+		select {
+		case <-ctx.Done():
+			t.Fatal("terminal alias did not follow cache refresh")
+		case <-ticker.C:
+		}
+	}
+}
