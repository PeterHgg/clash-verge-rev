+package config
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/metacubex/mihomo/component/resolver"
+)
+
+func TestParseHostsRejectsAliasCycles(t *testing.T) {
+	for name, hosts := range map[string]map[string]any{
+		"self":     {"a.example": "a.example"},
+		"multi":    {"a.example": "b.example", "b.example": "c.example", "c.example": "a.example"},
+		"case":     {"a.example": "B.EXAMPLE.", "b.example": "A.Example"},
+		"wildcard": {"*.example": "a.example"},
+		"suffix":   {"+.example": "a.example"},
+		"dot":      {".example": "a.example"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			if _, err := parseHosts(&RawConfig{Hosts: hosts}); !errors.Is(err, resolver.ErrHostAliasCycle) {
+				t.Fatalf("got %v", err)
+			}
+		})
+	}
+}
+
+func TestParseHostsAcceptsTerminalAliasAndWildcardOverride(t *testing.T) {
+	tree, err := parseHosts(&RawConfig{Hosts: map[string]any{
+		"origin.example":     "PREFERRED.EXAMPLE.",
+		"*.fixed.example":    "node.fixed.example",
+		"node.fixed.example": "192.0.2.1",
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	hosts := resolver.NewHosts(tree)
+	value, matched := hosts.Search("origin.example", false)
+	if matched || value == nil || !value.IsDomain || value.Domain != "preferred.example" {
+		t.Fatalf("terminal alias got %v, %v", value, matched)
+	}
+	value, matched = hosts.Search("other.fixed.example", false)
+	if !matched || value == nil || value.IsDomain || value.IPs[0].String() != "192.0.2.1" {
+		t.Fatalf("wildcard override got %v, %v", value, matched)
+	}
+}
