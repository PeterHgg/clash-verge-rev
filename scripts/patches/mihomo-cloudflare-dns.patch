@@ -0,0 +1,214 @@
+package resolver_test
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/netip"
+	"reflect"
+	"testing"
+
+	"github.com/metacubex/mihomo/component/dialer"
+	"github.com/metacubex/mihomo/component/resolver"
+	"github.com/metacubex/mihomo/component/trie"
+)
+
+type aliasResolver struct {
+	resolver.Resolver
+	lookup func(context.Context, string, string) ([]netip.Addr, error)
+}
+
+func (r *aliasResolver) Invalid() bool { return true }
+func (r *aliasResolver) LookupIPv4(ctx context.Context, host string) ([]netip.Addr, error) {
+	return r.lookup(ctx, host, "4")
+}
+func (r *aliasResolver) LookupIPv6(ctx context.Context, host string) ([]netip.Addr, error) {
+	return r.lookup(ctx, host, "6")
+}
+func (r *aliasResolver) LookupIP(ctx context.Context, host string) ([]netip.Addr, error) {
+	return r.lookup(ctx, host, "ip")
+}
+
+func installHosts(t *testing.T, entries map[string]string) resolver.Hosts {
+	t.Helper()
+	previous, ipv6, systemHosts := resolver.DefaultHosts, resolver.DisableIPv6, resolver.UseSystemHosts
+	t.Cleanup(func() {
+		resolver.DefaultHosts, resolver.DisableIPv6, resolver.UseSystemHosts = previous, ipv6, systemHosts
+	})
+	tree := trie.New[resolver.HostValue]()
+	for host, target := range entries {
+		value, err := resolver.NewHostValue([]string{target})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := tree.Insert(host, value); err != nil {
+			t.Fatal(err)
+		}
+	}
+	resolver.DefaultHosts = resolver.NewHosts(tree)
+	resolver.DisableIPv6, resolver.UseSystemHosts = false, false
+	return resolver.DefaultHosts
+}
+
+func TestHostsAliasLookupResolverAndFamily(t *testing.T) {
+	installHosts(t, map[string]string{"origin.example": "middle.example", "middle.example": "PREFERRED.EXAMPLE."})
+	oldDefault, oldSystem := resolver.DefaultResolver, resolver.SystemResolver
+	t.Cleanup(func() { resolver.DefaultResolver, resolver.SystemResolver = oldDefault, oldSystem })
+	type contextKey struct{}
+	ctx, cancel := context.WithCancel(context.WithValue(context.Background(), contextKey{}, "policy"))
+	defer cancel()
+	ip4, ip6 := netip.MustParseAddr("192.0.2.10"), netip.MustParseAddr("2001:db8::10")
+	for _, route := range []string{"selected", "default", "system"} {
+		for _, family := range []string{"4", "6", "ip"} {
+			t.Run(route+family, func(t *testing.T) {
+				calls := 0
+				want := []netip.Addr{ip4, ip6}
+				if family == "4" {
+					want = []netip.Addr{ip4}
+				} else if family == "6" {
+					want = []netip.Addr{ip6}
+				}
+				selected := &aliasResolver{lookup: func(got context.Context, host, f string) ([]netip.Addr, error) {
+					calls++
+					if got != ctx || got.Value(contextKey{}) != "policy" || host != "preferred.example" || f != family {
+						t.Errorf("resolver got context=%v host=%q family=%q", got, host, f)
+					}
+					return want, nil
+				}}
+				unexpected := &aliasResolver{lookup: func(context.Context, string, string) ([]netip.Addr, error) {
+					return nil, errors.New("wrong resolver selected")
+				}}
+				resolver.DefaultResolver, resolver.SystemResolver = unexpected, unexpected
+				var r resolver.Resolver = selected
+				if route == "default" {
+					resolver.DefaultResolver = selected
+					r = resolver.DefaultResolver
+				} else if route == "system" {
+					r, resolver.SystemResolver = nil, selected
+				}
+				lookup := resolver.LookupIPWithResolver
+				if family == "4" {
+					lookup = resolver.LookupIPv4WithResolver
+				} else if family == "6" {
+					lookup = resolver.LookupIPv6WithResolver
+				}
+				var got []netip.Addr
+				var err error
+				if route == "default" {
+					defaultLookup := resolver.LookupIP
+					if family == "4" {
+						defaultLookup = resolver.LookupIPv4
+					} else if family == "6" {
+						defaultLookup = resolver.LookupIPv6
+					}
+					got, err = defaultLookup(ctx, "origin.example")
+				} else {
+					got, err = lookup(ctx, "origin.example", r)
+				}
+				if err != nil || !reflect.DeepEqual(got, want) || calls != 1 {
+					t.Fatalf("got %v, %v, calls=%d; want %v", got, err, calls, want)
+				}
+			})
+		}
+	}
+}
+
+func TestHostsFixedAddressFamilyDoesNotFallThrough(t *testing.T) {
+	installHosts(t, map[string]string{"v4.example": "192.0.2.1", "v6.example": "2001:db8::1", "alias.example": "v4.example"})
+	r := &aliasResolver{lookup: func(context.Context, string, string) ([]netip.Addr, error) {
+		t.Error("fixed hosts binding fell through to DNS")
+		return nil, nil
+	}}
+	for _, tc := range []struct {
+		host   string
+		lookup func(context.Context, string, resolver.Resolver) ([]netip.Addr, error)
+	}{
+		{"v4.example", resolver.LookupIPv6WithResolver},
+		{"alias.example", resolver.LookupIPv6WithResolver},
+		{"v6.example", resolver.LookupIPv4WithResolver},
+	} {
+		if ips, err := tc.lookup(context.Background(), tc.host, r); !errors.Is(err, resolver.ErrIPVersion) || len(ips) != 0 {
+			t.Fatalf("%s: got %v, %v", tc.host, ips, err)
+		}
+	}
+	resolver.DisableIPv6 = true
+	if ips, err := resolver.LookupIPWithResolver(context.Background(), "v6.example", r); !errors.Is(err, resolver.ErrIPVersion) || len(ips) != 0 {
+		t.Fatalf("IPv4-only mixed lookup got %v, %v", ips, err)
+	}
+}
+
+func TestHostsAliasCyclesAndDepth(t *testing.T) {
+	for name, entries := range map[string]map[string]string{
+		"self":     {"a.example": "a.example"},
+		"multi":    {"a.example": "b.example", "b.example": "c.example", "c.example": "a.example"},
+		"case":     {"a.example": "B.EXAMPLE.", "b.example": "A.Example"},
+		"wildcard": {"*.example": "a.example"},
+		"suffix":   {"+.example": "a.example"},
+		"dot":      {".example": "a.example"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			hosts := installHosts(t, entries)
+			if err := hosts.Validate(); !errors.Is(err, resolver.ErrHostAliasCycle) {
+				t.Fatalf("validation got %v", err)
+			}
+			if _, _, err := hosts.SearchWithError("A.EXAMPLE.", false); !errors.Is(err, resolver.ErrHostAliasCycle) {
+				t.Fatalf("search got %v", err)
+			}
+			if _, err := resolver.LookupIPWithResolver(context.Background(), "a.example", nil); !errors.Is(err, resolver.ErrHostAliasCycle) {
+				t.Fatalf("lookup got %v", err)
+			}
+		})
+	}
+	entries := make(map[string]string)
+	for i := 0; i < 70; i++ {
+		entries[fmt.Sprintf("n%d.example", i)] = fmt.Sprintf("n%d.example", i+1)
+	}
+	hosts := installHosts(t, entries)
+	if _, _, err := hosts.SearchWithError("n0.example", false); err == nil {
+		t.Fatal("unbounded alias chain accepted")
+	}
+}
+
+func TestHostsAliasPreservesTLSIdentity(t *testing.T) {
+	identity := make(chan [2]string, 1)
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		identity <- [2]string{r.TLS.ServerName, r.Host}
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer server.Close()
+	original := server.Certificate().DNSNames[0]
+	installHosts(t, map[string]string{original: "preferred.example"})
+	roots := x509.NewCertPool()
+	roots.AddCert(server.Certificate())
+	host, port, err := net.SplitHostPort(server.Listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	r := &aliasResolver{lookup: func(_ context.Context, name, family string) ([]netip.Addr, error) {
+		if name != "preferred.example" || family != "4" {
+			return nil, fmt.Errorf("wrong lookup %s/%s", name, family)
+		}
+		return []netip.Addr{netip.MustParseAddr(host)}, nil
+	}}
+	transport := &http.Transport{
+		TLSClientConfig: &tls.Config{RootCAs: roots},
+		DialContext: func(ctx context.Context, network, address string) (net.Conn, error) {
+			return dialer.DialContext(ctx, "tcp4", address, dialer.WithResolver(r))
+		},
+	}
+	defer transport.CloseIdleConnections()
+	client := &http.Client{Transport: transport}
+	resp, err := client.Get("https://" + net.JoinHostPort(original, port) + "/")
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp.Body.Close()
+	if got := <-identity; got != [2]string{original, net.JoinHostPort(original, port)} {
+		t.Fatalf("identity changed: %v", got)
+	}
+}
