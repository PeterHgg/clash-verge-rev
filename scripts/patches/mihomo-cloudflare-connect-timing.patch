+// DialContextWithIPMeasured measures only the prepared socket connect, including socket controls.
+// Unlike ordinary dialing it cannot use address remapping, custom dialers, TFO or MPTCP.
+func DialContextWithIPMeasured(ctx context.Context, network string, destination netip.AddrPort, connectTimeout time.Duration, options ...Option) (net.Conn, time.Duration, error) {
+	if !destination.IsValid() || destination.Port() == 0 || destination.Addr().Zone() != "" {
+		return nil, 0, errors.New("invalid resolved destination")
+	}
+	ip := destination.Addr().Unmap()
+	if network != "tcp4" && network != "tcp6" && network != "tcp" {
+		return nil, 0, ErrorInvalidedNetworkStack
+	}
+	opt := applyOptions(options...)
+	if (network == "tcp4" && !ip.Is4()) || (network == "tcp6" && !ip.Is6()) || (opt.network == 4 && !ip.Is4()) || (opt.network == 6 && !ip.Is6()) {
+		return nil, 0, resolver.ErrIPVersion
+	}
+	if opt.tfo || opt.mpTcp {
+		return nil, 0, errors.New("measured connect does not support TFO or MPTCP")
+	}
+	if opt.netDialer != nil {
+		if _, ok := opt.netDialer.(*net.Dialer); !ok {
+			return nil, 0, errors.New("measured connect requires a native net.Dialer")
+		}
+	}
+	dialer, err := prepareNetDialer(network, ip, opt)
+	if err != nil {
+		return nil, 0, err
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, 0, err
+	}
+	ctx, cancel := context.WithTimeout(ctx, connectTimeout)
+	defer cancel()
+	address := netip.AddrPortFrom(ip, destination.Port()).String()
+	start := time.Now()
+	conn, err := dialer.DialContext(ctx, network, address)
+	elapsed := time.Since(start)
+	if ctx.Err() != nil {
+		if conn != nil {
+			conn.Close()
+		}
+		return nil, elapsed, ctx.Err()
+	}
+	return conn, elapsed, err
+}
