@@ -0,0 +1,129 @@
+package cloudflaretest
+
+import (
+	"context"
+	"errors"
+	"io"
+	"math"
+	"net"
+	"net/netip"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/component/dialer"
+)
+
+func TestScreenUsesRealConnectDurationOutsidePhysicalMetadata(t *testing.T) {
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	go func() {
+		for {
+			conn, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			conn.Close()
+		}
+	}()
+	candidate := netip.MustParseAddr("1.1.1.1")
+	destination := netip.MustParseAddrPort(listener.Addr().String())
+	j := &job{ctx: context.Background(), allowed: map[netip.Addr]bool{candidate: true}}
+	var measured []float64
+	checks := 0
+	j.dial = func(ctx context.Context, ip netip.Addr) (net.Conn, time.Duration, error) {
+		if ip != candidate {
+			t.Fatal("candidate identity changed")
+		}
+		verify := func(ctx context.Context, conn net.Conn) error {
+			checks++
+			if checks == 1 {
+				time.Sleep(3100 * time.Millisecond)
+			} else {
+				time.Sleep(40 * time.Millisecond)
+			}
+			return ctx.Err()
+		}
+		native := &net.Dialer{ControlContext: func(ctx context.Context, _, _ string, _ syscall.RawConn) error {
+			time.Sleep(30 * time.Millisecond)
+			return ctx.Err()
+		}}
+		conn, elapsed, err := dialVerifiedIP(ctx, destination, verify, func() []dialer.Option {
+			time.Sleep(100 * time.Millisecond)
+			return []dialer.Option{dialer.WithNetDialer(native)}
+		})
+		if err == nil {
+			measured = append(measured, float64(elapsed)/float64(time.Millisecond))
+		}
+		return conn, elapsed, err
+	}
+	start := time.Now()
+	result := j.screen(Result{IP: candidate.String(), State: "pending"})
+	total := time.Since(start)
+	if result.State != "screened" || result.Attempts != 4 || result.Failures != 0 || checks != 8 || result.LatencyMs == nil || math.Abs(*result.LatencyMs-average(measured)) > 1e-9 {
+		t.Fatalf("screen did not use exact real socket measurements: %+v measured=%v checks=%d", result, measured, checks)
+	}
+	if *result.LatencyMs < 30 || *result.LatencyMs >= 150 || total < 3*time.Second {
+		t.Fatalf("metadata leaked into timing or socket control omitted: connect=%v total=%v", *result.LatencyMs, total)
+	}
+	t.Logf("screen real loopback: average connect=%vms wall=%v; not physical binding proof", *result.LatencyMs, total)
+}
+
+func TestVerifiedConnectRejectsFailuresAndParentCancellation(t *testing.T) {
+	for _, stage := range []string{"pre-failure", "pre-cancel", "prepare-cancel", "post-failure", "post-cancel"} {
+		t.Run(stage, func(t *testing.T) {
+			listener, err := net.Listen("tcp4", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer listener.Close()
+			accepted := make(chan net.Conn, 1)
+			go func() {
+				conn, err := listener.Accept()
+				if err == nil {
+					accepted <- conn
+				}
+			}()
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			failure := errors.New("fixture interface changed")
+			verify := func(_ context.Context, conn net.Conn) error {
+				if conn == nil && stage == "pre-failure" || conn != nil && stage == "post-failure" {
+					return failure
+				}
+				if conn == nil && stage == "pre-cancel" || conn != nil && stage == "post-cancel" {
+					cancel()
+				}
+				return nil
+			}
+			options := func() []dialer.Option {
+				if stage == "prepare-cancel" {
+					cancel()
+				}
+				return nil
+			}
+			conn, elapsed, err := dialVerifiedIP(ctx, netip.MustParseAddrPort(listener.Addr().String()), verify, options)
+			if err == nil || conn != nil {
+				t.Fatalf("rejected sample returned a connection: %v %v", conn, err)
+			}
+			if stage == "post-failure" || stage == "post-cancel" {
+				select {
+				case server := <-accepted:
+					defer server.Close()
+					server.SetReadDeadline(time.Now().Add(time.Second))
+					_, err := server.Read(make([]byte, 1))
+					if err != io.EOF || elapsed <= 0 {
+						t.Fatalf("post verification rejection leaked socket: %v connect=%v", err, elapsed)
+					}
+				case <-time.After(time.Second):
+					t.Fatal("real loopback connection was not accepted")
+				}
+			} else if elapsed != 0 {
+				t.Fatalf("preparation failure counted as connect: %v", elapsed)
+			}
+		})
+	}
+}
