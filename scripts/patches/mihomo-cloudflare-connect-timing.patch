@@ -0,0 +1,84 @@
+package dialer
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func TestMeasuredConnectWindowsPrivateNICBinding(t *testing.T) {
+	interfaces, err := net.Interfaces()
+	if err != nil {
+		t.Skipf("private NIC enumeration unavailable: %v", err)
+	}
+	for _, iface := range interfaces {
+		if iface.Flags&net.FlagUp == 0 || iface.Flags&(net.FlagLoopback|net.FlagPointToPoint) != 0 || len(iface.HardwareAddr) < 6 {
+			continue
+		}
+		lower := strings.ToLower(iface.Name)
+		if strings.Contains(lower, "loopback") || strings.HasPrefix(lower, "tun") || strings.HasPrefix(lower, "clash") || strings.HasPrefix(lower, "mihomo") || strings.HasPrefix(lower, "verge") {
+			continue
+		}
+		addrs, err := iface.Addrs()
+		if err != nil {
+			continue
+		}
+		for _, addr := range addrs {
+			prefix, err := netip.ParsePrefix(addr.String())
+			if err != nil || !prefix.Addr().Is4() || !prefix.Addr().IsPrivate() {
+				continue
+			}
+			listener, err := net.Listen("tcp4", net.JoinHostPort(prefix.Addr().String(), "0"))
+			if err != nil {
+				t.Logf("private NIC listener unavailable on %s: %v", iface.Name, err)
+				continue
+			}
+			defer listener.Close()
+			accepted := make(chan net.Conn, 1)
+			go func() {
+				conn, err := listener.Accept()
+				if err == nil {
+					accepted <- conn
+				}
+			}()
+			destination := netip.MustParseAddrPort(listener.Addr().String())
+			start := time.Now()
+			conn, elapsed, err := DialContextWithIPMeasured(context.Background(), "tcp4", destination, time.Second, WithInterface(iface.Name))
+			if err != nil {
+				t.Fatalf("RFC1918 native interface-bound socket failed on %s (index %d): %v", iface.Name, iface.Index, err)
+			}
+			defer conn.Close()
+			if conn.LocalAddr().(*net.TCPAddr).AddrPort().Addr() != prefix.Addr() || conn.RemoteAddr().String() != destination.String() || elapsed <= 0 {
+				t.Fatalf("private bound socket addresses changed: local=%v remote=%v connect=%v", conn.LocalAddr(), conn.RemoteAddr(), elapsed)
+			}
+			raw, err := conn.(*net.TCPConn).SyscallConn()
+			if err != nil {
+				t.Fatal(err)
+			}
+			var value int
+			var socketErr error
+			if err := raw.Control(func(fd uintptr) {
+				value, socketErr = syscall.GetsockoptInt(syscall.Handle(fd), syscall.IPPROTO_IP, IP_UNICAST_IF)
+			}); err != nil || socketErr != nil {
+				t.Fatalf("cannot read actual IP_UNICAST_IF: %v %v", err, socketErr)
+			}
+			// IP_UNICAST_IF takes network byte order on set, but returns host byte order on get.
+			if value != iface.Index {
+				t.Fatalf("native binding bypassed: IP_UNICAST_IF=%d want index=%d", value, iface.Index)
+			}
+			select {
+			case server := <-accepted:
+				server.Close()
+			case <-time.After(time.Second):
+				t.Fatal("bound connection never reached private NIC listener")
+			}
+			t.Logf("real Windows RFC1918 socket binding verified: interface=%s index=%d IP_UNICAST_IF=%d local=%v destination=%v connect=%v total=%v; no Internet request", iface.Name, iface.Index, value, conn.LocalAddr(), destination, elapsed, time.Since(start))
+			return
+		}
+	}
+	t.Skip("no available up RFC1918 NIC/listener; loopback timing is not physical interface binding evidence")
+}
