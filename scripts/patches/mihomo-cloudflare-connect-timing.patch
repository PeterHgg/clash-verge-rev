+func TestMeasuredConnectIncludesSocketControlNotPreparation(t *testing.T) {
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	destination := netip.MustParseAddrPort(listener.Addr().String())
+	oldHosts := resolver.DefaultHosts
+	defer func() { resolver.DefaultHosts = oldHosts }()
+	hosts := trie.New[resolver.HostValue]()
+	if err := hosts.Insert("127.0.0.1", resolver.HostValue{IPs: []netip.Addr{netip.MustParseAddr("127.0.0.2")}}); err != nil {
+		t.Fatal(err)
+	}
+	resolver.DefaultHosts = resolver.NewHosts(hosts)
+	const preparation = 150 * time.Millisecond
+	const socketDelay = 60 * time.Millisecond
+	controls := 0
+	native := &net.Dialer{LocalAddr: &net.TCPAddr{IP: net.ParseIP("127.0.0.1")}, ControlContext: func(ctx context.Context, network, address string, _ syscall.RawConn) error {
+		controls++
+		if network != "tcp4" || address != destination.String() {
+			t.Errorf("literal destination changed: %s %s", network, address)
+		}
+		time.Sleep(socketDelay)
+		return ctx.Err()
+	}}
+	start := time.Now()
+	conn, elapsed, err := DialContextWithIPMeasured(context.Background(), "tcp4", destination, time.Second, func(opt *option) { time.Sleep(preparation) }, WithNetDialer(native), WithOnlySingleStack(true))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	if controls != 1 || elapsed < socketDelay || time.Since(start)-elapsed < preparation || elapsed >= preparation {
+		t.Fatalf("wrong clock boundary: controls=%d elapsed=%v total=%v", controls, elapsed, time.Since(start))
+	}
+	if conn.RemoteAddr().String() != destination.String() || native.KeepAliveConfig.Enable {
+		t.Fatal("destination changed or supplied net.Dialer was mutated")
+	}
+	t.Logf("real loopback connect (not physical binding proof): connect=%v total=%v", elapsed, time.Since(start))
+}
+
+func TestMeasuredConnectRejectsUnsupportedModesAndPreservesLiteralIP4P(t *testing.T) {
+	destination := netip.MustParseAddrPort("127.0.0.1:443")
+	custom := NetDialerFunc(func(context.Context, string, string) (net.Conn, error) {
+		t.Fatal("custom dialer bypassed native binding")
+		return nil, nil
+	})
+	for _, options := range [][]Option{{WithNetDialer(custom)}, {WithTFO(true)}, {WithMPTCP(true)}, {WithOnlySingleStack(false)}} {
+		conn, elapsed, err := DialContextWithIPMeasured(context.Background(), "tcp", destination, time.Second, options...)
+		if err == nil || conn != nil || elapsed != 0 {
+			t.Fatalf("unsupported mode reached connect: %v %v", elapsed, err)
+		}
+	}
+	old := resolver.GetIP4PEnable()
+	resolver.SetIP4PEnable(true)
+	defer resolver.SetIP4PEnable(old)
+	literal := netip.MustParseAddrPort("[2001::1bb:7f00:1]:443")
+	stop := errors.New("stop before any outbound connect")
+	called := false
+	native := &net.Dialer{ControlContext: func(_ context.Context, network, address string, _ syscall.RawConn) error {
+		called = true
+		if network != "tcp6" || address != literal.String() {
+			t.Errorf("IP4P remapped measured literal: %s %s", network, address)
+		}
+		return stop
+	}}
+	_, _, err := DialContextWithIPMeasured(context.Background(), "tcp6", literal, time.Second, WithNetDialer(native))
+	if !called {
+		t.Skipf("IPv6 socket unavailable before control: %v", err)
+	}
+	if !errors.Is(err, stop) {
+		t.Fatal(err)
+	}
+}
+
+func TestMeasuredConnectDeadlineStartsAfterPreparation(t *testing.T) {
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	destination := netip.MustParseAddrPort(listener.Addr().String())
+	conn, _, err := DialContextWithIPMeasured(context.Background(), "tcp4", destination, 40*time.Millisecond, func(*option) { time.Sleep(100 * time.Millisecond) })
+	if err != nil {
+		t.Fatalf("preparation consumed connect deadline: %v", err)
+	}
+	conn.Close()
+	for _, parentEarlier := range []bool{false, true} {
+		ctx := context.Background()
+		cancel := func() {}
+		if parentEarlier {
+			ctx, cancel = context.WithTimeout(ctx, 20*time.Millisecond)
+		}
+		start := time.Now()
+		native := &net.Dialer{ControlContext: func(ctx context.Context, _, _ string, _ syscall.RawConn) error { <-ctx.Done(); return ctx.Err() }}
+		conn, elapsed, err := DialContextWithIPMeasured(ctx, "tcp4", destination, 100*time.Millisecond, WithNetDialer(native))
+		cancel()
+		if conn != nil || !errors.Is(err, context.DeadlineExceeded) || elapsed <= 0 || time.Since(start) > time.Second {
+			t.Fatalf("deadline not honored: parent=%v connect=%v err=%v", parentEarlier, elapsed, err)
+		}
+		if parentEarlier && elapsed >= 90*time.Millisecond {
+			t.Fatalf("earlier parent deadline extended: %v", elapsed)
+		}
+	}
+}
