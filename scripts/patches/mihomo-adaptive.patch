+func adaptivePolicyFixture(t *testing.T, delays ...uint16) (*LoadBalance, *adaptivePolicyProvider, []*adaptivePolicyProxy, *time.Time) {
+	t.Helper()
+	now := time.Now().Truncate(time.Second)
+	provider := &adaptivePolicyProvider{version: 1}
+	var proxies []*adaptivePolicyProxy
+	for i, delay := range delays {
+		proxy := &adaptivePolicyProxy{Proxy: adapter.NewProxy(outbound.NewDirect()), name: fmt.Sprintf("node-%d", i), history: make(map[string]C.ProxyState)}
+		proxy.setHealth(testUrl, now, true, delay)
+		proxies = append(proxies, proxy)
+		provider.proxies = append(provider.proxies, proxy)
+	}
+	lb, err := NewLoadBalance(GroupCommonOption{Name: "adaptive", URL: testUrl, ExpectedStatus: "204", ManualHealthCheck: true},
+		LoadBalanceOption{Strategy: "round-robin", Adaptive: true}, adapter.NewProxy(outbound.NewDirect()), []P.ProxyProvider{provider})
+	require.NoError(t, err)
+	lb.adaptive.now = func() time.Time { return now }
+	lb.adaptive.recomputeLocked(now)
+	// Model tests drive ticks themselves and never start background/network work.
+	lb.adaptive.active = true
+	t.Cleanup(lb.RetireAdaptive)
+	return lb, provider, proxies, &now
+}
