+package tunnel
+
+import (
+	"reflect"
+	"testing"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+type adaptiveLifecycleProxy struct {
+	C.Proxy
+	adapter C.ProxyAdapter
+}
+
+func (p *adaptiveLifecycleProxy) Adapter() C.ProxyAdapter { return p.adapter }
+
+type adaptiveLifecycleAdapter struct {
+	C.ProxyAdapter
+	events *[]string
+	name   string
+	closes int
+}
+
+func (a *adaptiveLifecycleAdapter) ActivateAdaptive() {
+	configMux.RLock()
+	configMux.RUnlock()
+	*a.events = append(*a.events, "activate:"+a.name)
+}
+
+func (a *adaptiveLifecycleAdapter) RetireAdaptive() {
+	configMux.RLock()
+	configMux.RUnlock()
+	*a.events = append(*a.events, "retire:"+a.name)
+}
+
+func (a *adaptiveLifecycleAdapter) Close() error {
+	a.closes++
+	return nil
+}
+
+func TestUpdateProxiesAdaptiveLifecycle(t *testing.T) {
+	configMux.Lock()
+	previousProxies, previousProviders := proxies, providers
+	proxies = nil
+	providers = nil
+	configMux.Unlock()
+	t.Cleanup(func() {
+		UpdateProxies(nil, nil)
+		configMux.Lock()
+		proxies, providers = previousProxies, previousProviders
+		configMux.Unlock()
+	})
+
+	var events []string
+	old := &adaptiveLifecycleAdapter{events: &events, name: "old"}
+	retained := &adaptiveLifecycleAdapter{events: &events, name: "retained"}
+	fresh := &adaptiveLifecycleAdapter{events: &events, name: "fresh"}
+	if len(events) != 0 {
+		t.Fatal("construction activated adaptive state")
+	}
+	oldProxy := &adaptiveLifecycleProxy{adapter: old}
+	retainedProxy := &adaptiveLifecycleProxy{adapter: retained}
+	UpdateProxies(map[string]C.Proxy{"old": oldProxy, "alias": oldProxy, "retained": retainedProxy}, nil)
+	events = nil
+	UpdateProxies(map[string]C.Proxy{
+		"renamed-retained": retainedProxy,
+		"fresh":            &adaptiveLifecycleProxy{adapter: fresh},
+		"ordinary":         &adaptiveLifecycleProxy{adapter: struct{ C.ProxyAdapter }{}},
+	}, nil)
+	if len(events) != 3 || events[0] != "retire:old" {
+		t.Fatalf("expected old retirement before new activation, got %v", events)
+	}
+	activated := map[string]bool{events[1]: true, events[2]: true}
+	if !reflect.DeepEqual(activated, map[string]bool{"activate:retained": true, "activate:fresh": true}) {
+		t.Fatalf("unexpected activation events %v", events)
+	}
+	if old.closes != 0 || retained.closes != 0 || fresh.closes != 0 {
+		t.Fatal("reload closed an adapter instead of retiring adaptive work")
+	}
+	events = nil
+	UpdateProxies(nil, nil)
+	if len(events) != 2 {
+		t.Fatalf("removal did not retire each adaptive adapter once: %v", events)
+	}
+}
