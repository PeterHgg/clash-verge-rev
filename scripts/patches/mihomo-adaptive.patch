+package outboundgroup
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/netip"
+	"os"
+	"sync"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/common/buf"
+	N "github.com/metacubex/mihomo/common/net"
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/sing/common/bufio"
+	SN "github.com/metacubex/sing/common/network"
+
+	"github.com/stretchr/testify/require"
+)
+
+func adaptiveTransportTestAdmission(t *testing.T) *adaptiveAdmission {
+	t.Helper()
+	member := &adaptiveMember{valid: true, confirmed: true, alive: true, checked: time.Now()}
+	controller := &adaptiveController{now: time.Now, flows: make(map[*adaptiveFlow]*adaptiveAdmission), members: []*adaptiveMember{member}}
+	return &adaptiveAdmission{controller: controller, member: member}
+}
+
+type adaptiveTestConn struct {
+	C.Conn
+	reader     *bytes.Reader
+	written    bytes.Buffer
+	writeLimit int
+	readErr    error
+	writeErr   error
+	closeErr   error
+	closes     int
+	deadline   time.Time
+	chain      C.Chain
+	providers  C.Chain
+}
+
+func (c *adaptiveTestConn) Read(p []byte) (int, error) {
+	if c.readErr != nil {
+		return 0, c.readErr
+	}
+	return c.reader.Read(p)
+}
+func (c *adaptiveTestConn) Write(p []byte) (int, error) {
+	if c.writeLimit >= 0 && c.writeLimit < len(p) {
+		p = p[:c.writeLimit]
+	}
+	n, _ := c.written.Write(p)
+	return n, c.writeErr
+}
+func (c *adaptiveTestConn) ReadBuffer(buffer *buf.Buffer) error {
+	n, err := c.Read(buffer.FreeBytes())
+	buffer.Truncate(n)
+	return err
+}
+func (c *adaptiveTestConn) WriteBuffer(buffer *buf.Buffer) error {
+	defer buffer.Release()
+	_, err := c.Write(buffer.Bytes())
+	return err
+}
+func (c *adaptiveTestConn) Close() error                       { c.closes++; return c.closeErr }
+func (c *adaptiveTestConn) LocalAddr() net.Addr                { return &net.TCPAddr{Port: 1234} }
+func (c *adaptiveTestConn) RemoteAddr() net.Addr               { return &net.TCPAddr{Port: 443} }
+func (c *adaptiveTestConn) SetDeadline(t time.Time) error      { c.deadline = t; return nil }
+func (c *adaptiveTestConn) SetReadDeadline(t time.Time) error  { c.deadline = t; return nil }
+func (c *adaptiveTestConn) SetWriteDeadline(t time.Time) error { c.deadline = t; return nil }
+func (c *adaptiveTestConn) Chains() C.Chain                    { return c.chain }
+func (c *adaptiveTestConn) ProviderChains() C.Chain            { return c.providers }
+func (c *adaptiveTestConn) AppendToChains(a C.ProxyAdapter)    { c.chain = append(c.chain, a.Name()) }
+func (c *adaptiveTestConn) RemoteDestination() string          { return "egress.example" }
+
+func TestAdaptiveFlowDrainsOnlyActiveWindows(t *testing.T) {
+	flow := newAdaptiveFlow(&C.Metadata{Host: "Example.COM.", DstPort: 443})
+	other := newAdaptiveFlow(&C.Metadata{Host: "example.com", DstPort: 443})
+	require.NotEqual(t, flow.id, other.id)
+	require.Equal(t, flow.cohort, other.cohort)
+	flow.last = time.Now().Add(-time.Minute)
+	flow.countDownload(20)
+	flow.countUpload(10)
+	flow.countUpload(-1)
+	now := time.Now()
+	sample := flow.drain(now)
+	require.Equal(t, uint64(20), sample.download)
+	require.Equal(t, uint64(10), sample.upload)
+	require.Equal(t, time.Second, sample.duration)
+	idle := flow.drain(now.Add(time.Second))
+	require.Zero(t, idle.download)
+	require.Zero(t, idle.upload)
+	require.Zero(t, idle.duration)
+	ip := newAdaptiveFlow(&C.Metadata{DstIP: netip.MustParseAddr("192.0.2.1"), DstPort: 443})
+	mapped := newAdaptiveFlow(&C.Metadata{DstIP: netip.MustParseAddr("::ffff:192.0.2.1"), DstPort: 443})
+	require.Equal(t, ip.cohort, mapped.cohort)
+}
+
+func TestAdaptiveTransportFailureClassification(t *testing.T) {
+	for _, err := range []error{nil, io.EOF, context.Canceled, context.DeadlineExceeded, os.ErrDeadlineExceeded, net.ErrClosed, os.ErrClosed} {
+		require.False(t, adaptiveTransportFailure(err), "%v", err)
+		if err != nil {
+			require.False(t, adaptiveTransportFailure(errors.Join(errors.New("transport"), err)), "%v", err)
+		}
+	}
+	require.True(t, adaptiveTransportFailure(io.ErrUnexpectedEOF))
+	require.True(t, adaptiveTransportFailure(errors.New("handshake rejected")))
+}
+
+func TestAdaptiveConnByteAccountingAndMetadata(t *testing.T) {
+	admission := adaptiveTransportTestAdmission(t)
+	underlying := &adaptiveTestConn{reader: bytes.NewReader([]byte("download")), writeLimit: -1, chain: C.Chain{"node"}, providers: C.Chain{"provider"}}
+	conn := newAdaptiveConn(underlying, admission, &C.Metadata{Host: "example.com"}).(*adaptiveConn)
+	defer conn.Close()
+	payload := make([]byte, 3)
+	n, err := conn.Read(payload)
+	require.NoError(t, err)
+	require.Equal(t, 3, n)
+	buffer := buf.New()
+	require.NoError(t, conn.ReadBuffer(buffer))
+	require.Equal(t, "nload", string(buffer.Bytes()))
+	buffer.Release()
+	_, err = conn.Write([]byte("up"))
+	require.NoError(t, err)
+	require.NoError(t, conn.WriteBuffer(buf.As([]byte("load"))))
+	sample := conn.flow.drain(time.Now())
+	require.Equal(t, uint64(8), sample.download)
+	require.Equal(t, uint64(6), sample.upload)
+	require.Equal(t, underlying.chain, conn.Chains())
+	require.Equal(t, underlying.providers, conn.ProviderChains())
+	require.Equal(t, "egress.example", conn.RemoteDestination())
+	require.Equal(t, underlying.LocalAddr(), conn.LocalAddr())
+	require.Equal(t, underlying.RemoteAddr(), conn.RemoteAddr())
+	deadline := time.Now().Add(time.Minute)
+	require.NoError(t, conn.SetDeadline(deadline))
+	require.Equal(t, deadline, underlying.deadline)
+	require.Same(t, underlying, conn.Upstream())
+	require.Same(t, conn, N.UnwrapReader(conn))
+	require.Same(t, conn, N.UnwrapWriter(conn))
+}
