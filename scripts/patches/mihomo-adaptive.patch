+type adaptiveTestPacketConn struct {
+	C.PacketConn
+	data       []byte
+	put        func()
+	addr       net.Addr
+	closes     int
+	writeLimit int
+	writeErr   error
+	resolved   *C.Metadata
+	readErr    error
+}
+
+func (c *adaptiveTestPacketConn) ReadFrom(p []byte) (int, net.Addr, error) {
+	return copy(p, c.data), c.addr, c.readErr
+}
+func (c *adaptiveTestPacketConn) WaitReadFrom() ([]byte, func(), net.Addr, error) {
+	return c.data, c.put, c.addr, c.readErr
+}
+func (c *adaptiveTestPacketConn) WriteTo(p []byte, _ net.Addr) (int, error) {
+	if c.writeLimit >= 0 && c.writeLimit < len(p) {
+		return c.writeLimit, c.writeErr
+	}
+	return len(p), c.writeErr
+}
+func (c *adaptiveTestPacketConn) ResolveUDP(_ context.Context, metadata *C.Metadata) error {
+	c.resolved = metadata
+	return nil
+}
+func (c *adaptiveTestPacketConn) Close() error { c.closes++; return nil }
+
+func TestAdaptivePacketConnWaitReadOwnershipAndBytes(t *testing.T) {
+	admission := adaptiveTransportTestAdmission(t)
+	puts := 0
+	underlying := &adaptiveTestPacketConn{data: []byte("packet"), put: func() { puts++ }, addr: &net.UDPAddr{Port: 53}, writeLimit: 2}
+	conn := newAdaptivePacketConn(underlying, admission, nil).(*adaptivePacketConn)
+	data, put, addr, err := conn.WaitReadFrom()
+	require.NoError(t, err)
+	require.Equal(t, underlying.addr, addr)
+	require.Equal(t, "packet", string(data))
+	require.Equal(t, 0, puts)
+	data[0] = 'P'
+	require.Equal(t, byte('P'), underlying.data[0])
+	put()
+	require.Equal(t, 1, puts)
+	payload := make([]byte, 3)
+	n, _, err := conn.ReadFrom(payload)
+	require.NoError(t, err)
+	require.Equal(t, 3, n)
+	n, err = conn.WriteTo([]byte("upload"), addr)
+	require.NoError(t, err)
+	require.Equal(t, 2, n)
+	sample := conn.flow.drain(time.Now())
+	require.Equal(t, uint64(9), sample.download)
+	require.Equal(t, uint64(2), sample.upload)
+	metadata := &C.Metadata{Host: "resolve.example"}
+	require.NoError(t, conn.ResolveUDP(context.Background(), metadata))
+	require.Same(t, metadata, underlying.resolved)
+	underlying.readErr = errors.New("UDP transport failed")
+	_, _, _, err = conn.WaitReadFrom()
+	require.ErrorIs(t, err, underlying.readErr)
+	underlying.writeErr = underlying.readErr
+	_, err = conn.WriteTo([]byte("fail"), addr)
+	require.ErrorIs(t, err, underlying.readErr)
+	require.Zero(t, admission.member.failures)
+	require.True(t, admission.member.alive)
+	require.True(t, admission.member.cooldown.IsZero())
+	require.False(t, conn.ReaderReplaceable())
+	require.False(t, conn.WriterReplaceable())
+	require.NoError(t, conn.Close())
+	require.NoError(t, conn.Close())
+	require.Equal(t, 1, underlying.closes)
+}
