+func TestAdaptiveConnCopyCountersDoNotDoubleCount(t *testing.T) {
+	admission := adaptiveTransportTestAdmission(t)
+	underlying := &adaptiveTestConn{reader: bytes.NewReader([]byte("copy download")), writeLimit: -1}
+	conn := newAdaptiveConn(underlying, admission, nil).(*adaptiveConn)
+	defer conn.Close()
+	reader, counters := SN.UnwrapCountReader(conn, nil)
+	require.NotSame(t, conn, reader)
+	require.Len(t, counters, 1)
+	var destination bytes.Buffer
+	n, err := bufio.Copy(&destination, conn)
+	require.NoError(t, err)
+	require.Equal(t, int64(len("copy download")), n)
+	n, err = bufio.Copy(conn, bytes.NewReader([]byte("copy upload")))
+	require.NoError(t, err)
+	require.Equal(t, int64(len("copy upload")), n)
+	sample := conn.flow.drain(time.Now())
+	require.Equal(t, uint64(len("copy download")), sample.download)
+	require.Equal(t, uint64(len("copy upload")), sample.upload)
+	require.Equal(t, "copy download", destination.String())
+	require.Equal(t, "copy upload", underlying.written.String())
+}
