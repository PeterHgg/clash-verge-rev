diff --git a/adapter/outboundgroup/adaptive.go b/adapter/outboundgroup/adaptive.go
new file mode 100644
index 0000000..4cceb27
--- /dev/null
+++ b/adapter/outboundgroup/adaptive.go
@@ -0,0 +1,1212 @@
+package outboundgroup
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"math"
+	"reflect"
+	"sort"
+	"sync"
+	"time"
+
+	"github.com/metacubex/mihomo/common/utils"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+const (
+	adaptiveMaxMembers = 2048
+	adaptiveMaxFlows   = 2048
+	adaptiveMaxSamples = 128
+	adaptiveFreshness  = 180 * time.Second
+	adaptiveTrialTime  = 180 * time.Second
+)
+
+var errAdaptiveUnavailable = errors.New("adaptive: no confirmed available member")
+var errAdaptiveUnsupported = errors.New("adaptive: unsupported candidate source")
+
+type adaptiveSample struct {
+	flowID, cohort   uint64
+	at               time.Time
+	duration         time.Duration
+	download, upload uint64
+	flowIDs          [2]uint64
+}
+
+type adaptiveMember struct {
+	proxy                   C.Proxy
+	identity                uintptr
+	valid, confirmed, alive bool
+	checked                 time.Time
+	latency                 *float64
+	jitter                  float64
+	failures                int
+	cooldown, nextChance    time.Time
+	protected               time.Time
+	waitingSince            time.Time
+	samples                 [adaptiveMaxSamples]adaptiveSample
+	sampleCount             int
+	mean, peak, confidence  float64
+	proven                  bool
+	score                   *float64
+}
+
+type adaptiveTrial struct {
+	candidate, displaced *adaptiveMember
+	started              time.Time
+	lease                *adaptiveTrialLease
+	controls             []adaptiveTrialControl
+}
+
+type adaptiveTrialControl struct {
+	anchor    *adaptiveMember
+	reference map[adaptiveComparisonCohort]float64
+}
+
+type adaptiveController struct {
+	mu       sync.Mutex
+	lb       *LoadBalance
+	now      func() time.Time
+	expected utils.IntRanges[uint16]
+	ctx      context.Context
+	cancel   context.CancelFunc
+	active   bool
+	retired  bool
+	reason   string
+	version  uint32
+	loaded   bool
+	members  []*adaptiveMember
+	all      []string
+	selected []*adaptiveMember
+	trial    *adaptiveTrial
+	lastTick time.Time
+	cursor   uint64
+	total    uint64
+	attempts uint64
+	lease    *adaptiveTrialLease
+	flows    map[*adaptiveFlow]*adaptiveAdmission
+}
+
+type adaptiveAdmission struct {
+	controller *adaptiveController
+	member     *adaptiveMember
+	proxy      C.Proxy
+	lease      *adaptiveTrialLease
+	failed     sync.Once
+	released   sync.Once
+}
+
+// A retired trial keeps this global lease until its actual native connections close.
+type adaptiveTrialLease struct {
+	refs      int
+	admitting bool
+}
+
+var adaptiveTrialOwner struct {
+	sync.Mutex
+	lease *adaptiveTrialLease
+}
+
+func acquireAdaptiveTrial() *adaptiveTrialLease {
+	adaptiveTrialOwner.Lock()
+	defer adaptiveTrialOwner.Unlock()
+	if adaptiveTrialOwner.lease != nil {
+		return nil
+	}
+	lease := &adaptiveTrialLease{admitting: true}
+	adaptiveTrialOwner.lease = lease
+	return lease
+}
+
+func finishAdaptiveTrial(lease *adaptiveTrialLease) {
+	adaptiveTrialOwner.Lock()
+	defer adaptiveTrialOwner.Unlock()
+	lease.admitting = false
+	if lease.refs == 0 && adaptiveTrialOwner.lease == lease {
+		adaptiveTrialOwner.lease = nil
+	}
+}
+
+func adaptiveTrialDraining(lease *adaptiveTrialLease) bool {
+	adaptiveTrialOwner.Lock()
+	defer adaptiveTrialOwner.Unlock()
+	return lease != nil && adaptiveTrialOwner.lease == lease && !lease.admitting && lease.refs > 0
+}
+
+func newAdaptiveController(lb *LoadBalance) (*adaptiveController, error) {
+	expected, err := utils.NewUnsignedRanges[uint16](lb.expectedStatus)
+	if err != nil {
+		return nil, err
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	c := &adaptiveController{lb: lb, now: time.Now, expected: expected, ctx: ctx, cancel: cancel,
+		flows: make(map[*adaptiveFlow]*adaptiveAdmission)}
+	c.refreshLocked(c.now())
+	c.recomputeLocked(c.now())
+	return c, nil
+}
+
+func (c *adaptiveController) activate() {
+	c.mu.Lock()
+	if c.active || c.retired {
+		c.mu.Unlock()
+		return
+	}
+	c.active = true
+	adaptiveHealth.add(c)
+	c.mu.Unlock()
+}
+
+func (c *adaptiveController) retire() {
+	c.mu.Lock()
+	if c.retired {
+		c.mu.Unlock()
+		return
+	}
+	c.retired = true
+	c.cancel()
+	if c.trial != nil {
+		finishAdaptiveTrial(c.trial.lease)
+		c.trial = nil
+	}
+	for _, member := range c.members {
+		member.valid = false
+	}
+	c.selected = nil
+	c.flows = nil
+	c.mu.Unlock()
+	adaptiveHealth.remove(c)
+}
+
+func adaptiveIdentity(proxy C.Proxy) uintptr {
+	if proxy == nil {
+		return 0
+	}
+	value := reflect.ValueOf(proxy)
+	if value.Kind() != reflect.Pointer || value.IsNil() {
+		return 0
+	}
+	return value.Pointer()
+}
+
+func adaptiveLeaf(proxy C.Proxy) bool {
+	if proxy == nil {
+		return false
+	}
+	if _, nested := proxy.Adapter().(ProxyGroup); nested {
+		return false
+	}
+	switch proxy.Type() {
+	case C.Direct, C.Compatible, C.Reject, C.RejectDrop, C.Pass, C.PassRule, C.Rematch, C.Dns,
+		C.Selector, C.Fallback, C.URLTest, C.LoadBalance:
+		return false
+	}
+	return proxy.ProxyInfo().DialerProxy == "" && adaptiveIdentity(proxy) != 0
+}
+
+func (c *adaptiveController) refreshLocked(now time.Time) {
+	if c.retired {
+		return
+	}
+	providers := c.lb.providers
+	if len(providers) != 1 {
+		c.invalidateLocked("adaptive supports one static or proxy-provider candidate source")
+		return
+	}
+	version := providers[0].Version()
+	if c.loaded && c.version == version {
+		return
+	}
+	c.loaded, c.version = true, version
+	if c.trial != nil {
+		finishAdaptiveTrial(c.trial.lease)
+		c.trial = nil
+	}
+	for _, member := range c.members {
+		member.valid = false
+	}
+	c.members, c.selected = nil, nil
+	c.flows = make(map[*adaptiveFlow]*adaptiveAdmission)
+	c.reason = ""
+	c.all = nil
+	if providers[0].Count() > adaptiveMaxMembers {
+		c.reason = "adaptive candidate limit exceeded (2048)"
+		return
+	}
+	if providers[0].Count() == 0 {
+		c.reason = "adaptive candidate source is empty"
+		if fallback := c.lb.EmptyFallback(); fallback != nil {
+			c.all = []string{fallback.Name()}
+		}
+		return
+	}
+	proxies := c.lb.GetProxies(false)
+	if len(proxies) > adaptiveMaxMembers {
+		c.reason = "adaptive candidate limit exceeded (2048)"
+		return
+	}
+	for _, proxy := range proxies {
+		if proxy != nil {
+			c.all = append(c.all, proxy.Name())
+		}
+	}
+	seenNames := make(map[string]bool, len(proxies))
+	seenIDs := make(map[uintptr]bool, len(proxies))
+	var udpSupport *bool
+	for _, proxy := range proxies {
+		identity := adaptiveIdentity(proxy)
+		if !adaptiveLeaf(proxy) || seenNames[proxy.Name()] || seenIDs[identity] {
+			c.invalidateLocked("adaptive requires distinct, unambiguous leaf proxies without dialer-proxy")
+			return
+		}
+		if proxy.IsL3Protocol(nil) {
+			c.invalidateLocked("adaptive does not support L3 protocol members; original strategy remains active")
+			return
+		}
+		supportsUDP := proxy.SupportUDP()
+		if !c.lb.disableUDP && udpSupport != nil && *udpSupport != supportsUDP {
+			c.invalidateLocked("adaptive does not support mixed UDP capabilities; original strategy remains active")
+			return
+		}
+		udpSupport = &supportsUDP
+		seenNames[proxy.Name()], seenIDs[identity] = true, true
+		member := &adaptiveMember{proxy: proxy, identity: identity, valid: true, waitingSince: now}
+		c.readHealthLocked(member, now)
+		c.members = append(c.members, member)
+	}
+	c.lastTick = time.Time{}
+}
+
+func (c *adaptiveController) invalidateLocked(reason string) {
+	if c.trial != nil {
+		finishAdaptiveTrial(c.trial.lease)
+		c.trial = nil
+	}
+	for _, member := range c.members {
+		member.valid = false
+	}
+	c.members, c.selected, c.reason = nil, nil, reason
+	c.flows = make(map[*adaptiveFlow]*adaptiveAdmission)
+}
+
+func (c *adaptiveController) readHealthLocked(member *adaptiveMember, now time.Time) {
+	state, ok := member.proxy.ExtraDelayHistories()[c.lb.testUrl]
+	if !ok || len(state.History) == 0 {
+		return
+	}
+	last := state.History[len(state.History)-1]
+	if last.Time.IsZero() || last.Time.After(now.Add(time.Second)) || !last.Time.After(member.checked) {
+		return
+	}
+	member.checked, member.confirmed, member.alive = last.Time, true, state.Alive
+	if state.Alive && !now.Before(member.cooldown) && member.failures > 0 {
+		member.failures--
+	}
+	member.latency = nil
+	if state.Alive && last.Delay > 0 {
+		latency := float64(last.Delay)
+		member.latency = &latency
+	}
+	var sum, squares float64
+	var count int
+	for _, history := range state.History {
+		if history.Delay > 0 {
+			value := float64(history.Delay)
+			sum += value
+			squares += value * value
+			count++
+		}
+	}
+	if count > 1 && sum > 0 {
+		mean := sum / float64(count)
+		member.jitter = math.Sqrt(math.Max(0, squares/float64(count)-mean*mean)) / mean
+	}
+}
+
+func (m *adaptiveMember) available(now time.Time) bool {
+	return m.valid && m.confirmed && m.alive && now.Sub(m.checked) <= adaptiveFreshness
+}
+
+func (c *adaptiveController) preview() C.Proxy {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	now := c.now()
+	c.refreshLocked(now)
+	if c.reason != "" && !c.retired {
+		return nil
+	}
+	for _, member := range c.selected {
+		if member.available(now) {
+			return member.proxy
+		}
+	}
+	// Unwrap is also used for capability inspection, not just actual admission.
+	for _, member := range c.members {
+		if member.valid {
+			return member.proxy
+		}
+	}
+	return c.lb.EmptyFallback()
+}
+
+func (c *adaptiveController) admit() (*adaptiveAdmission, error) {
+	return c.admitNetwork(false)
+}
+
+func (c *adaptiveController) admitNetwork(udp bool) (*adaptiveAdmission, error) {
+	c.activate()
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	now := c.now()
+	c.refreshLocked(now)
+	if c.retired {
+		return nil, errAdaptiveUnavailable
+	}
+	if c.reason != "" {
+		return nil, fmt.Errorf("%w: %s", errAdaptiveUnsupported, c.reason)
+	}
+	if udp && (c.lb.disableUDP || len(c.members) == 0 || !c.members[0].proxy.SupportUDP()) {
+		return nil, C.ErrNotSupport
+	}
+	if c.lastTick.IsZero() {
+		c.recomputeLocked(now)
+	}
+	ready := false
+	for _, member := range c.selected {
+		ready = ready || member.available(now)
+	}
+	if !ready {
+		return nil, errAdaptiveUnavailable
+	}
+	c.total++
+	var member *adaptiveMember
+	var lease *adaptiveTrialLease
+	if c.trial != nil && c.attempts < c.total/20 && c.trial.candidate.available(now) {
+		member, lease = c.trial.candidate, c.trial.lease
+		c.attempts++
+		adaptiveTrialOwner.Lock()
+		lease.refs++
+		adaptiveTrialOwner.Unlock()
+	} else {
+		mains := c.selected
+		if c.trial != nil {
+			mains = mains[:len(mains)-1]
+		}
+		if len(mains) == 0 {
+			return nil, errAdaptiveUnavailable
+		}
+		for i := 0; i < len(mains); i++ {
+			index := c.cursor % uint64(len(mains))
+			c.cursor++
+			if mains[index].available(now) {
+				member = mains[index]
+				break
+			}
+		}
+		if member == nil {
+			return nil, errAdaptiveUnavailable
+		}
+	}
+	return &adaptiveAdmission{controller: c, member: member, proxy: member.proxy, lease: lease}, nil
+}
+
+func (a *adaptiveAdmission) fail(err error) {
+	if err == nil || errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded) || errors.Is(err, C.ErrNotSupport) {
+		return
+	}
+	a.failed.Do(func() {
+		c := a.controller
+		c.mu.Lock()
+		defer c.mu.Unlock()
+		if c.retired || !a.member.valid {
+			return
+		}
+		now := c.now()
+		// A destination refusal/reset is not proof that the proxy itself is unavailable.
+		if c.trial != nil && c.trial.candidate == a.member {
+			c.endTrialLocked(now, false, false)
+		}
+	})
+}
+
+func adaptiveFailureBackoff(failures int) time.Duration {
+	minutes := [...]int{5, 15, 45, 120}
+	index := failures - 1
+	if index < 0 {
+		index = 0
+	}
+	if index >= len(minutes) {
+		index = len(minutes) - 1
+	}
+	return time.Duration(minutes[index]) * time.Minute
+}
+
+func (a *adaptiveAdmission) release() {
+	a.released.Do(func() {
+		if a.lease == nil {
+			return
+		}
+		adaptiveTrialOwner.Lock()
+		defer adaptiveTrialOwner.Unlock()
+		a.lease.refs--
+		if a.lease.refs == 0 && !a.lease.admitting && adaptiveTrialOwner.lease == a.lease {
+			adaptiveTrialOwner.lease = nil
+		}
+	})
+}
+
+func (a *adaptiveAdmission) registerFlow(flow *adaptiveFlow) bool {
+	c := a.controller
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.retired || !a.member.valid || len(c.flows) >= adaptiveMaxFlows {
+		return false
+	}
+	c.flows[flow] = a
+	return true
+}
+
+func (a *adaptiveAdmission) finishFlow(flow *adaptiveFlow) {
+	c := a.controller
+	c.mu.Lock()
+	if _, registered := c.flows[flow]; registered {
+		c.addSampleLocked(a.member, flow.drain(c.now()))
+		delete(c.flows, flow)
+	}
+	c.mu.Unlock()
+	a.release()
+}
+
+func (a *adaptiveAdmission) flowSample(sample adaptiveSample) {
+	c := a.controller
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.addSampleLocked(a.member, sample)
+}
+
+func (c *adaptiveController) addSampleLocked(member *adaptiveMember, sample adaptiveSample) {
+	if c.retired || !member.valid || sample.duration <= 0 || sample.download+sample.upload == 0 {
+		return
+	}
+	if sample.duration < 100*time.Millisecond {
+		return
+	}
+	window := sample.at.Unix() / 15
+	bucket := int(window % 8)
+	if bucket < 0 {
+		bucket += 8
+	}
+	start := bucket * 16
+	upload := sample.download == 0
+	for i := start; i < start+16; i++ {
+		existing := &member.samples[i]
+		if existing.duration > 0 && existing.at.Unix()/15 == window && existing.cohort == sample.cohort && (existing.download == 0) == upload {
+			existing.download += sample.download
+			existing.upload += sample.upload
+			existing.duration += sample.duration
+			existing.at = sample.at
+			adaptiveRememberFlow(&existing.flowIDs, sample.flowID)
+			return
+		}
+	}
+	for i := start; i < start+16; i++ {
+		existing := &member.samples[i]
+		if existing.duration == 0 || existing.at.Unix()/15 != window {
+			if existing.duration == 0 {
+				member.sampleCount++
+			}
+			sample.flowIDs = [2]uint64{}
+			adaptiveRememberFlow(&sample.flowIDs, sample.flowID)
+			member.samples[i] = sample
+			return
+		}
+	}
+}
+
+func adaptiveRememberFlow(ids *[2]uint64, id uint64) {
+	if id == 0 || ids[0] == id || ids[1] == id {
+		return
+	}
+	if ids[0] == 0 {
+		ids[0] = id
+	} else if ids[1] == 0 {
+		ids[1] = id
+	}
+}
+
+func (c *adaptiveController) tick(now time.Time) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.retired {
+		return
+	}
+	c.refreshLocked(now)
+	if !c.lastTick.IsZero() && now.Sub(c.lastTick) < time.Second {
+		return
+	}
+	for flow, admission := range c.flows {
+		c.addSampleLocked(admission.member, flow.drain(now))
+	}
+	for _, member := range c.members {
+		c.readHealthLocked(member, now)
+	}
+	c.recomputeLocked(now)
+}
+
+func adaptiveRates(member *adaptiveMember, now time.Time) {
+	var weightedBytes, weightedSeconds, newest float64
+	rates := make([]float64, 0, member.sampleCount)
+	flows := make(map[uint64]bool)
+	windows := make(map[int64]bool)
+	for i := 0; i < adaptiveMaxSamples; i++ {
+		sample := member.samples[i]
+		age := math.Max(0, now.Sub(sample.at).Seconds())
+		weight := math.Exp2(-age / 300)
+		if sample.duration < 100*time.Millisecond || weight < 0.01 {
+			continue
+		}
+		bytes := sample.download
+		if sample.upload > bytes {
+			bytes = sample.upload
+		}
+		if bytes == 0 {
+			continue
+		}
+		weightedBytes += float64(bytes) * weight
+		weightedSeconds += sample.duration.Seconds() * weight
+		rates = append(rates, float64(bytes)/sample.duration.Seconds())
+		newest = math.Max(newest, weight)
+		for _, id := range sample.flowIDs {
+			if id != 0 {
+				flows[id] = true
+			}
+		}
+		windows[sample.at.Unix()/15] = true
+	}
+	member.mean, member.peak, member.confidence, member.proven = 0, 0, 0, false
+	if weightedSeconds == 0 {
+		return
+	}
+	member.mean = weightedBytes / weightedSeconds
+	sort.Float64s(rates)
+	member.peak = rates[(len(rates)-1)*9/10]
+	member.confidence = math.Min(1, float64(len(windows))/6) * math.Min(1, float64(len(flows))/3) * newest
+	member.proven = len(windows) >= 2 && len(flows) >= 2 && newest >= 0.5
+}
+
+func adaptiveQuality(value, reference float64) float64 {
+	if value <= 0 || reference <= 0 || math.IsNaN(value) || math.IsNaN(reference) || math.IsInf(value, 0) || math.IsInf(reference, 0) {
+		return 0
+	}
+	if value >= reference {
+		return 1
+	}
+	return value / reference
+}
+
+func (c *adaptiveController) recomputeLocked(now time.Time) {
+	c.lastTick = now
+	var bestMean, bestPeak float64
+	bestLatency := math.Inf(1)
+	for _, member := range c.members {
+		adaptiveRates(member, now)
+		if !member.available(now) {
+			continue
+		}
+		bestMean = math.Max(bestMean, member.mean)
+		bestPeak = math.Max(bestPeak, member.peak)
+		if member.latency != nil && *member.latency > 0 && !math.IsInf(*member.latency, 0) {
+			bestLatency = math.Min(bestLatency, *member.latency)
+		}
+	}
+	for _, member := range c.members {
+		member.score = nil
+		if !member.available(now) {
+			continue
+		}
+		latency := 0.0
+		if member.latency != nil {
+			latency = adaptiveQuality(bestLatency, *member.latency)
+		}
+		if member.latency == nil && member.mean == 0 {
+			continue
+		}
+		mean := adaptiveQuality(member.mean, bestMean)
+		peak := adaptiveQuality(member.peak, bestPeak)
+		stability := adaptiveQuality(1, 1+float64(member.failures)+member.jitter)
+		passive := 45*mean + 25*peak + 15*latency + 15*stability
+		prior := 100 * latency
+		confidence := adaptiveQuality(member.confidence, 1)
+		score := math.Min(100, prior*(1-confidence)+passive*confidence)
+		member.score = &score
+	}
+	c.pruneLocked(now)
+	if c.trial != nil {
+		if !c.trial.candidate.available(now) {
+			c.endTrialLocked(now, false, false)
+		} else if adaptiveTrialComparable(c.trial, now) {
+			c.trial.displaced.waitingSince = now
+			c.trial.displaced.nextChance = now.Add(c.chanceIntervalLocked(c.trial.displaced))
+			c.endTrialLocked(now, true, false)
+			return
+		} else if now.Sub(c.trial.started) >= adaptiveTrialTime {
+			c.endTrialLocked(now, false, false)
+			return
+		}
+	}
+	if c.trial == nil && c.total >= 20 {
+		c.startTrialLocked(now)
+	}
+}
+
+func adaptiveBetter(a, b *adaptiveMember) bool {
+	if a.score != nil && b.score != nil {
+		return *a.score > *b.score
+	}
+	if a.score != nil {
+		return true
+	}
+	if b.score != nil {
+		return false
+	}
+	return a.proxy.Name() < b.proxy.Name()
+}
+
+func (c *adaptiveController) pruneLocked(now time.Time) {
+	selected := make([]*adaptiveMember, 0, 3)
+	for _, member := range c.selected {
+		if member.available(now) {
+			selected = append(selected, member)
+		}
+	}
+	c.selected = selected
+	if c.trial != nil {
+		if !c.trial.candidate.available(now) || len(c.selected) < 3 {
+			c.endTrialLocked(now, false, false)
+		} else {
+			return
+		}
+	}
+	var ready []*adaptiveMember
+	proven := false
+	for _, member := range c.members {
+		if member.available(now) && !now.Before(member.cooldown) {
+			ready = append(ready, member)
+			proven = proven || member.proven
+		}
+	}
+	sort.SliceStable(ready, func(i, j int) bool { return adaptiveBetter(ready[i], ready[j]) })
+	if !proven {
+		var protected []*adaptiveMember
+		for _, member := range c.selected {
+			if now.Before(member.protected) {
+				protected = append(protected, member)
+			}
+		}
+		c.selected = protected
+	}
+	for _, member := range ready {
+		if len(c.selected) >= 3 {
+			break
+		}
+		if !adaptiveContains(c.selected, member) {
+			c.selected = append(c.selected, member)
+		}
+	}
+}
+
+func adaptiveContains(members []*adaptiveMember, member *adaptiveMember) bool {
+	for _, existing := range members {
+		if existing == member {
+			return true
+		}
+	}
+	return false
+}
+
+func (c *adaptiveController) chanceIntervalLocked(member *adaptiveMember) time.Duration {
+	best := 0.0
+	for _, candidate := range c.selected {
+		if candidate.score != nil {
+			best = math.Max(best, *candidate.score)
+		}
+	}
+	if member.failures > 0 || member.jitter > 0.5 || (member.score != nil && best > 0 && *member.score < best*0.5) {
+		return 600 * time.Second
+	}
+	if member.score == nil || (best > 0 && *member.score < best*0.85) {
+		return 180 * time.Second
+	}
+	return 60 * time.Second
+}
+
+func (c *adaptiveController) startTrialLocked(now time.Time) {
+	if c.trial != nil || len(c.selected) < 3 || c.reason != "" {
+		return
+	}
+	// Trials are for observed capability; latency-only startup never needs one.
+	hasEvidence := false
+	for _, member := range c.selected {
+		hasEvidence = hasEvidence || member.proven
+	}
+	if !hasEvidence {
+		return
+	}
+	weakest := -1
+	for i, member := range c.selected {
+		if now.Before(member.protected) {
+			continue
+		}
+		if weakest < 0 || adaptiveBetter(c.selected[weakest], member) {
+			weakest = i
+		}
+	}
+	if weakest < 0 {
+		return
+	}
+	var candidate *adaptiveMember
+	var priority float64
+	for _, member := range c.members {
+		if !member.available(now) || now.Before(member.cooldown) || now.Before(member.nextChance) || adaptiveContains(c.selected, member) {
+			continue
+		}
+		interval := c.chanceIntervalLocked(member)
+		overdue := math.Max(0, now.Sub(member.waitingSince).Seconds()) / interval.Seconds()
+		quality := 0.0
+		if member.score != nil {
+			quality = *member.score / 100
+		}
+		value := overdue + quality
+		if candidate == nil || value > priority {
+			candidate, priority = member, value
+		}
+	}
+	if candidate == nil {
+		return
+	}
+	lease := acquireAdaptiveTrial()
+	if lease == nil {
+		return
+	}
+	// Quota accrued before this candidate's admission is not initial trial credit.
+	c.attempts = c.total / 20
+	displaced := c.selected[weakest]
+	candidate.waitingSince = now
+	mains := make([]*adaptiveMember, 0, 3)
+	for i, member := range c.selected {
+		if i != weakest {
+			mains = append(mains, member)
+		}
+	}
+	c.selected = append(mains, candidate)
+	c.lease = lease
+	c.trial = &adaptiveTrial{candidate: candidate, displaced: displaced, started: now, lease: lease}
+	baseline := adaptiveComparisonValues(displaced, now.Add(-2*time.Minute), now)
+	for _, anchor := range mains {
+		reference := adaptiveReferenceRatios(baseline, adaptiveComparisonValues(anchor, now.Add(-2*time.Minute), now))
+		if len(reference) > 0 {
+			c.trial.controls = append(c.trial.controls, adaptiveTrialControl{anchor: anchor, reference: reference})
+		}
+	}
+}
+
+func (c *adaptiveController) endTrialLocked(now time.Time, promote, failed bool) {
+	trial := c.trial
+	if trial == nil {
+		return
+	}
+	c.trial = nil
+	finishAdaptiveTrial(trial.lease)
+	if promote {
+		trial.candidate.protected = now.Add(10 * time.Minute)
+		trial.candidate.failures = 0
+		return
+	}
+	mains := make([]*adaptiveMember, 0, 3)
+	for _, member := range c.selected {
+		if member != trial.candidate && member.available(now) {
+			mains = append(mains, member)
+		}
+	}
+	if trial.displaced != nil && trial.displaced.available(now) && !adaptiveContains(mains, trial.displaced) {
+		mains = append(mains, trial.displaced)
+	}
+	c.selected = mains
+	trial.candidate.waitingSince = now
+	trial.candidate.nextChance = now.Add(c.chanceIntervalLocked(trial.candidate))
+	if !failed && trial.candidate.cooldown.Before(now.Add(5*time.Minute)) {
+		trial.candidate.cooldown = now.Add(5 * time.Minute)
+	}
+}
+
+type adaptiveComparisonKey struct {
+	cohort uint64
+	window int64
+	upload bool
+}
+
+type adaptiveComparisonValue struct {
+	bytes, seconds float64
+	flows          map[uint64]bool
+}
+
+type adaptiveComparisonCohort struct {
+	cohort uint64
+	upload bool
+}
+
+func adaptiveComparisonValues(member *adaptiveMember, started, now time.Time) map[adaptiveComparisonKey]adaptiveComparisonValue {
+	values := make(map[adaptiveComparisonKey]adaptiveComparisonValue)
+	for i := 0; i < adaptiveMaxSamples; i++ {
+		sample := member.samples[i]
+		if sample.at.Before(started) || sample.at.After(now) || sample.duration < 100*time.Millisecond {
+			continue
+		}
+		bytes, upload := sample.download, false
+		if bytes == 0 {
+			bytes, upload = sample.upload, true
+		}
+		if bytes == 0 || sample.cohort == 0 {
+			continue
+		}
+		key := adaptiveComparisonKey{cohort: sample.cohort, window: sample.at.Unix() / 15, upload: upload}
+		value := values[key]
+		if value.flows == nil {
+			value.flows = make(map[uint64]bool)
+		}
+		for _, id := range sample.flowIDs {
+			if id != 0 {
+				value.flows[id] = true
+			}
+		}
+		value.bytes += float64(bytes)
+		value.seconds += sample.duration.Seconds()
+		values[key] = value
+	}
+	return values
+}
+
+func adaptiveReferenceRatios(baseline, anchor map[adaptiveComparisonKey]adaptiveComparisonValue) map[adaptiveComparisonCohort]float64 {
+	ratios := make(map[adaptiveComparisonCohort]float64)
+	windows := make(map[adaptiveComparisonCohort]map[int64]bool)
+	leftFlows, rightFlows := make(map[adaptiveComparisonCohort]map[uint64]bool), make(map[adaptiveComparisonCohort]map[uint64]bool)
+	for key, left := range baseline {
+		right, ok := anchor[key]
+		if !ok || left.seconds == 0 || right.seconds == 0 || right.bytes == 0 {
+			continue
+		}
+		cohort := adaptiveComparisonCohort{cohort: key.cohort, upload: key.upload}
+		if windows[cohort] == nil {
+			windows[cohort], leftFlows[cohort], rightFlows[cohort] = make(map[int64]bool), make(map[uint64]bool), make(map[uint64]bool)
+		}
+		windows[cohort][key.window] = true
+		for id := range left.flows {
+			leftFlows[cohort][id] = true
+		}
+		for id := range right.flows {
+			rightFlows[cohort][id] = true
+		}
+		ratio := (left.bytes / left.seconds) / (right.bytes / right.seconds)
+		ratios[cohort] = math.Max(ratios[cohort], ratio)
+	}
+	for cohort := range ratios {
+		if len(windows[cohort]) < 2 || len(leftFlows[cohort]) < 2 || len(rightFlows[cohort]) < 2 {
+			delete(ratios, cohort)
+		}
+	}
+	return ratios
+}
+
+func adaptiveComparisonPass(left, right map[adaptiveComparisonKey]adaptiveComparisonValue, reference map[adaptiveComparisonCohort]float64) bool {
+	windows := make(map[int64]bool)
+	matchedLeft, matchedRight := make(map[uint64]bool), make(map[uint64]bool)
+	for key, a := range left {
+		b, ok := right[key]
+		if !ok || a.seconds == 0 || b.seconds == 0 || b.bytes == 0 {
+			continue
+		}
+		ratio := 1.0
+		if reference != nil {
+			var known bool
+			ratio, known = reference[adaptiveComparisonCohort{cohort: key.cohort, upload: key.upload}]
+			if !known {
+				continue
+			}
+		}
+		if (a.bytes/a.seconds)/(b.bytes/b.seconds) < 1.1*ratio-1e-9 {
+			return false
+		}
+		for id := range a.flows {
+			matchedLeft[id] = true
+		}
+		for id := range b.flows {
+			matchedRight[id] = true
+		}
+		windows[key.window] = true
+	}
+	return len(windows) >= 2 && len(matchedLeft) >= 2 && len(matchedRight) >= 2
+}
+
+func adaptiveComparable(candidate, baseline *adaptiveMember, started, now time.Time) bool {
+	return adaptiveComparisonPass(adaptiveComparisonValues(candidate, started, now), adaptiveComparisonValues(baseline, started, now), nil)
+}
+
+func adaptiveTrialComparable(trial *adaptiveTrial, now time.Time) bool {
+	if trial.displaced != nil && adaptiveComparable(trial.candidate, trial.displaced, trial.started, now) {
+		return true
+	}
+	candidate := adaptiveComparisonValues(trial.candidate, trial.started, now)
+	for _, control := range trial.controls {
+		if !control.anchor.available(now) {
+			continue
+		}
+		anchor := adaptiveComparisonValues(control.anchor, trial.started, now)
+		if adaptiveComparisonPass(candidate, anchor, control.reference) {
+			return true
+		}
+	}
+	return false
+}
+
+type adaptiveCandidateStatus struct {
+	Name                     string   `json:"name"`
+	Score                    *float64 `json:"score"`
+	Selected                 bool     `json:"selected"`
+	Reachable                bool     `json:"reachable"`
+	FreshHealth              bool     `json:"freshHealth"`
+	Proven                   bool     `json:"proven"`
+	Confidence               float64  `json:"confidence"`
+	MeanRate                 float64  `json:"meanRate"`
+	PeakRate                 float64  `json:"peakRate"`
+	LatencyMs                *float64 `json:"latencyMs"`
+	State                    string   `json:"state"`
+	CooldownRemainingSeconds *uint32  `json:"cooldownRemainingSeconds"`
+	LastCheckedSecondsAgo    *uint32  `json:"lastCheckedSecondsAgo"`
+}
+
+type adaptiveStatus struct {
+	all           []string
+	SchemaVersion int                       `json:"schemaVersion"`
+	Capability    string                    `json:"capability"`
+	State         string                    `json:"state"`
+	Reason        *string                   `json:"reason"`
+	Candidates    []adaptiveCandidateStatus `json:"candidates"`
+}
+
+func adaptiveSeconds(duration time.Duration) *uint32 {
+	seconds := uint32(math.Min(math.Max(0, duration.Seconds()), math.MaxUint32))
+	return &seconds
+}
+
+func (c *adaptiveController) snapshot() adaptiveStatus {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	now := c.now()
+	c.refreshLocked(now)
+	status := adaptiveStatus{all: append([]string(nil), c.all...), SchemaVersion: 1, Capability: "verge-adaptive1", State: "warming", Candidates: make([]adaptiveCandidateStatus, 0, len(c.members))}
+	if c.retired || c.reason != "" {
+		status.State = "unsupported"
+		reason := c.reason
+		if c.retired {
+			reason = "adaptive group retired"
+		}
+		status.Reason = &reason
+	} else if c.trial != nil {
+		status.State = "trial"
+	} else if adaptiveTrialDraining(c.lease) {
+		status.State = "draining"
+	} else {
+		ready, allConfirmed := false, len(c.members) > 0
+		for _, member := range c.selected {
+			ready = ready || member.available(now)
+		}
+		for _, member := range c.members {
+			allConfirmed = allConfirmed && member.confirmed
+		}
+		if ready {
+			status.State = "active"
+		} else if allConfirmed {
+			status.State = "unavailable"
+		}
+	}
+	for _, member := range c.members {
+		selected := adaptiveContains(c.selected, member) && member.available(now)
+		candidate := adaptiveCandidateStatus{Name: member.proxy.Name(), Score: member.score, Selected: selected,
+			Reachable: member.available(now), FreshHealth: member.available(now), Proven: member.proven,
+			Confidence: member.confidence, MeanRate: member.mean, PeakRate: member.peak, LatencyMs: member.latency, State: "standby"}
+		switch {
+		case c.trial != nil && c.trial.candidate == member:
+			candidate.State = "trial"
+		case selected:
+			candidate.State = "selected"
+		case now.Before(member.cooldown):
+			candidate.State = "cooldown"
+		case !member.confirmed:
+			candidate.State = "untested"
+		case !member.available(now):
+			candidate.State = "unavailable"
+		}
+		if !member.checked.IsZero() {
+			candidate.LastCheckedSecondsAgo = adaptiveSeconds(now.Sub(member.checked))
+		}
+		if now.Before(member.cooldown) {
+			candidate.CooldownRemainingSeconds = adaptiveSeconds(member.cooldown.Sub(now))
+		}
+		status.Candidates = append(status.Candidates, candidate)
+	}
+	return status
+}
+
+// The registry has one scheduler and at most one native URLTest in flight globally.
+var adaptiveHealth = adaptiveHealthRegistry{wake: make(chan struct{}, 1)}
+
+type adaptiveHealthRegistry struct {
+	mu       sync.Mutex
+	groups   []*adaptiveController
+	cursor   int
+	running  bool
+	inFlight bool
+	lastTest time.Time
+	wake     chan struct{}
+}
+
+func (r *adaptiveHealthRegistry) notify() {
+	select {
+	case r.wake <- struct{}{}:
+	default:
+	}
+}
+
+func (r *adaptiveHealthRegistry) add(c *adaptiveController) {
+	r.mu.Lock()
+	r.groups = append(r.groups, c)
+	if !r.running {
+		r.running = true
+		go r.run()
+	}
+	r.mu.Unlock()
+	r.notify()
+}
+
+func (r *adaptiveHealthRegistry) remove(c *adaptiveController) {
+	r.mu.Lock()
+	for i, group := range r.groups {
+		if group == c {
+			r.groups = append(r.groups[:i], r.groups[i+1:]...)
+			break
+		}
+	}
+	r.mu.Unlock()
+	r.notify()
+}
+
+func (r *adaptiveHealthRegistry) run() {
+	ticker := time.NewTicker(time.Second)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ticker.C:
+		case <-r.wake:
+		}
+		r.mu.Lock()
+		if len(r.groups) == 0 && !r.inFlight {
+			r.running = false
+			r.mu.Unlock()
+			return
+		}
+		groups := append([]*adaptiveController(nil), r.groups...)
+		cursor, busy, lastTest := r.cursor, r.inFlight, r.lastTest
+		r.mu.Unlock()
+		now := time.Now()
+		for _, group := range groups {
+			group.tick(now)
+		}
+		if busy || len(groups) == 0 || now.Sub(lastTest) < time.Second {
+			continue
+		}
+		for i := 0; i < len(groups); i++ {
+			index := (cursor + i) % len(groups)
+			group := groups[index]
+			member := group.healthCandidate(now)
+			if member == nil {
+				continue
+			}
+			r.mu.Lock()
+			r.inFlight = true
+			r.lastTest = now
+			r.cursor = (index + 1) % len(groups)
+			r.mu.Unlock()
+			go func() {
+				group.checkHealth(member)
+				r.mu.Lock()
+				r.inFlight = false
+				r.mu.Unlock()
+				r.notify()
+			}()
+			break
+		}
+	}
+}
+
+func (c *adaptiveController) healthCandidate(now time.Time) *adaptiveMember {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.retired || c.reason != "" {
+		return nil
+	}
+	var candidate *adaptiveMember
+	var priority float64
+	for _, member := range c.members {
+		interval := c.chanceIntervalLocked(member)
+		selected := adaptiveContains(c.selected, member)
+		if selected {
+			interval = 60 * time.Second
+		}
+		value := now.Sub(member.checked).Seconds() / interval.Seconds()
+		if !member.confirmed {
+			value = 100
+		} else if value < 1 {
+			continue
+		} else if selected {
+			value += 10000
+		}
+		if candidate == nil || value > priority {
+			candidate, priority = member, value
+		}
+	}
+	return candidate
+}
+
+func (c *adaptiveController) checkHealth(member *adaptiveMember) {
+	timeout := time.Duration(c.lb.testTimeout) * time.Millisecond
+	if timeout < time.Millisecond {
+		timeout = time.Millisecond
+	}
+	if timeout > 5*time.Second {
+		timeout = 5 * time.Second
+	}
+	ctx, cancel := context.WithTimeout(c.ctx, timeout)
+	defer cancel()
+	if ctx.Err() != nil {
+		return
+	}
+	_, err := member.proxy.URLTest(ctx, c.lb.testUrl, c.expected)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.retired || !member.valid || c.ctx.Err() != nil {
+		return
+	}
+	now := c.now()
+	previous := member.checked
+	c.readHealthLocked(member, now)
+	if !member.checked.After(previous) {
+		// Native URLTest normally writes this history; missing exact history is never success.
+		member.checked, member.confirmed, member.alive = now, true, false
+	}
+	if err != nil || !member.alive {
+		member.alive = false
+		member.failures++
+		member.cooldown = now.Add(adaptiveFailureBackoff(member.failures))
+	}
+	c.lastTick = time.Time{}
+}
