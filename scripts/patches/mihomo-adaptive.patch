+func TestAdaptivePassiveWeightsConfidenceAndIdle(t *testing.T) {
+	lb, _, _, now := adaptivePolicyFixture(t, 10, 30, 40, 50)
+	c := lb.adaptive
+	start := now.Add(-75 * time.Second)
+	for i, member := range c.members {
+		rate := uint64(100)
+		if i == 1 {
+			rate = 1000
+		}
+		adaptivePolicyEvidence(c, member, start, rate, uint64(i*10+1))
+	}
+	c.recomputeLocked(*now)
+	for _, member := range c.members {
+		latency := 10 / *member.latency
+		passive := 45*(member.mean/c.members[1].mean) + 25*(member.peak/c.members[1].peak) + 15*latency + 15
+		want := 100*latency*(1-member.confidence) + passive*member.confidence
+		require.InDelta(t, want, *member.score, 1e-12, "45/25/15/15 weights and confidence blend must remain unchanged")
+	}
+	require.Greater(t, *c.members[1].score, *c.members[0].score, "observed throughput must outweigh single low RTT")
+	beforeMean, beforeConfidence := c.members[1].mean, c.members[1].confidence
+	adaptiveRates(c.members[1], now.Add(5*time.Minute))
+	require.InDelta(t, beforeMean, c.members[1].mean, 0.001, "idle is not a zero-rate observation")
+	require.InDelta(t, beforeConfidence/2, c.members[1].confidence, 0.001)
+	c.addSampleLocked(c.members[1], adaptiveSample{at: *now, duration: time.Second})
+	require.Equal(t, 6, c.members[1].sampleCount)
+}
