+func TestAdaptiveQualityBounds(t *testing.T) {
+	for _, test := range []struct {
+		name             string
+		value, reference float64
+		want             float64
+	}{
+		{"relative", 10, 1000, 0.01},
+		{"equal", 10, 10, 1},
+		{"old-fast", 1000, 10, 1},
+		{"zero-value", 0, 10, 0},
+		{"zero-reference", 10, 0, 0},
+		{"negative-value", -10, 10, 0},
+		{"negative-reference", 10, -10, 0},
+		{"nan-value", math.NaN(), 10, 0},
+		{"nan-reference", 10, math.NaN(), 0},
+		{"infinite-value", math.Inf(1), 10, 0},
+		{"infinite-reference", 10, math.Inf(1), 0},
+		{"negative-infinite-value", math.Inf(-1), 10, 0},
+		{"negative-infinite-reference", 10, math.Inf(-1), 0},
+		{"overflow-ratio", math.MaxFloat64, math.SmallestNonzeroFloat64, 1},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			quality := adaptiveQuality(test.value, test.reference)
+			require.Equal(t, test.want, quality)
+			score := 45*quality + 25*quality + 15*quality + 15*quality
+			require.False(t, math.IsNaN(score) || math.IsInf(score, 0))
+			require.GreaterOrEqual(t, score, 0.0)
+			require.LessOrEqual(t, score, 100.0)
+			_, err := json.Marshal(score)
+			require.NoError(t, err)
+		})
+	}
+}
