+func TestAdaptiveTrialQuotaRollbackProtectionAndGlobalDrain(t *testing.T) {
+	lb, _, _, now := adaptivePolicyFixture(t, 10, 20, 30, 40, 50)
+	c := lb.adaptive
+	for i := 0; i < 3; i++ {
+		adaptivePolicyEvidence(c, c.members[i], now.Add(-75*time.Second), uint64(300-i*50), uint64(10*i+1))
+	}
+	c.recomputeLocked(*now)
+	for i := 0; i < 19; i++ {
+		a, err := c.admit()
+		require.NoError(t, err)
+		require.Nil(t, a.lease)
+		a.release()
+	}
+	c.tick(now.Add(time.Second))
+	require.Nil(t, c.trial, "no initial quota credit")
+	a, err := c.admit()
+	require.NoError(t, err)
+	a.release()
+	*now = now.Add(2 * time.Second)
+	c.tick(*now)
+	require.NotNil(t, c.trial)
+	candidate, displaced := c.trial.candidate, c.trial.displaced
+	require.Len(t, c.selected, 3)
+	require.NotContains(t, c.selected, displaced)
+	var held []*adaptiveAdmission
+	for i := 0; i < 181; i++ {
+		a, err := c.admit()
+		require.NoError(t, err)
+		if a.lease != nil {
+			held = append(held, a)
+		} else {
+			a.release()
+		}
+		require.LessOrEqual(t, c.attempts, c.total/20)
+	}
+	require.Equal(t, 9, len(held))
+	lease := held[0].lease
+	*now = now.Add(180 * time.Second)
+	// Keep native health current; expiry itself should not cause the rollback.
+	for _, member := range c.members {
+		member.checked = *now
+	}
+	c.recomputeLocked(*now)
+	require.Nil(t, c.trial)
+	require.Contains(t, c.selected, displaced)
+	require.NotContains(t, c.selected, candidate)
+	require.Equal(t, now.Add(5*time.Minute), candidate.cooldown)
+	require.Nil(t, acquireAdaptiveTrial(), "old native trial connections still own global lease")
+	for _, admission := range held {
+		admission.release()
+		admission.release()
+	}
+	require.Zero(t, lease.refs)
+	newLease := acquireAdaptiveTrial()
+	require.NotNil(t, newLease)
+	finishAdaptiveTrial(newLease)
+
+	candidate.cooldown, candidate.nextChance = time.Time{}, time.Time{}
+	c.startTrialLocked(*now)
+	require.NotNil(t, c.trial)
+	candidate, displaced = c.trial.candidate, c.trial.displaced
+	started := c.trial.started
+	for i := 0; i < 2; i++ {
+		at := started.Add(time.Duration(i+1) * 16 * time.Second)
+		c.addSampleLocked(candidate, adaptiveSample{flowID: uint64(500 + i), cohort: 77, at: at, duration: time.Second, download: 110})
+		c.addSampleLocked(displaced, adaptiveSample{flowID: uint64(600 + i), cohort: 77, at: at, duration: time.Second, download: 100})
+	}
+	*now = started.Add(33 * time.Second)
+	for _, member := range c.members {
+		member.checked = *now
+	}
+	c.recomputeLocked(*now)
+	require.Nil(t, c.trial)
+	require.Equal(t, now.Add(10*time.Minute), candidate.protected)
+	c.total = 500
+	c.startTrialLocked(*now)
+	if c.trial != nil {
+		require.NotSame(t, candidate, c.trial.displaced)
+	}
+}
