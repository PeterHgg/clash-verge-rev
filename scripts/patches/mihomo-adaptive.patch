+func TestAdaptiveConnRemainsUsableAfterRetirement(t *testing.T) {
+	admission := adaptiveTransportTestAdmission(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	admission.controller.ctx, admission.controller.cancel = ctx, cancel
+	underlying := &adaptiveTestConn{reader: bytes.NewReader([]byte("still active")), writeLimit: -1}
+	conn := newAdaptiveConn(underlying, admission, nil)
+	admission.controller.retire()
+	require.ErrorIs(t, ctx.Err(), context.Canceled)
+	require.Zero(t, underlying.closes)
+	n, err := conn.Write([]byte("ongoing"))
+	require.NoError(t, err)
+	require.Equal(t, len("ongoing"), n)
+	require.NoError(t, conn.Close())
+	require.NoError(t, conn.Close())
+	require.Equal(t, 1, underlying.closes)
+}
