+type adaptivePolicyProxy struct {
+	C.Proxy
+	mu      sync.Mutex
+	name    string
+	history map[string]C.ProxyState
+	tests   int
+	testURL string
+	status  utils.IntRanges[uint16]
+	testErr error
+	dials   int
+	dialErr error
+	l3      bool
+	noUDP   bool
+}
+
+func (p *adaptivePolicyProxy) IsL3Protocol(*C.Metadata) bool { return p.l3 }
+func (p *adaptivePolicyProxy) SupportUDP() bool              { return !p.noUDP }
+
+func (p *adaptivePolicyProxy) Name() string        { return p.name }
+func (p *adaptivePolicyProxy) Type() C.AdapterType { return C.Shadowsocks }
+func (p *adaptivePolicyProxy) ExtraDelayHistories() map[string]C.ProxyState {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	copy := make(map[string]C.ProxyState)
+	for url, state := range p.history {
+		copy[url] = state
+	}
+	return copy
+}
+func (p *adaptivePolicyProxy) setHealth(url string, at time.Time, alive bool, delay uint16) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.history[url] = C.ProxyState{Alive: alive, History: []C.DelayHistory{{Time: at, Delay: delay}}}
+}
+func (p *adaptivePolicyProxy) URLTest(ctx context.Context, url string, status utils.IntRanges[uint16]) (uint16, error) {
+	p.mu.Lock()
+	p.tests++
+	p.testURL, p.status = url, status
+	err := p.testErr
+	p.mu.Unlock()
+	p.setHealth(url, time.Now(), err == nil, 0)
+	return 0, err
+}
+func (p *adaptivePolicyProxy) DialContext(context.Context, *C.Metadata) (C.Conn, error) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.dials++
+	return nil, p.dialErr
+}
+
+type adaptivePolicyProvider struct {
+	P.ProxyProvider
+	mu      sync.Mutex
+	proxies []C.Proxy
+	version uint32
+}
+
+func (p *adaptivePolicyProvider) Touch() {}
+
+func (p *adaptivePolicyProvider) Version() uint32 {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return p.version
+}
+func (p *adaptivePolicyProvider) Proxies() []C.Proxy {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return append([]C.Proxy(nil), p.proxies...)
+}
+func (p *adaptivePolicyProvider) Count() int {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return len(p.proxies)
+}
+func (p *adaptivePolicyProvider) replace(proxies []C.Proxy) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.proxies = proxies
+	p.version++
+}
