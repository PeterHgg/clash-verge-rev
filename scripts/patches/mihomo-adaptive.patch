+	require.Contains(t, c.selected, c.members[2])
+	c.startTrialLocked(*now)
+	require.NotNil(t, c.trial)
+	require.Same(t, good, c.trial.candidate)
+	admission, err := c.admit()
+	require.NoError(t, err)
+	require.Nil(t, admission.lease)
+	admission.release()
+	c.retire()
+	lease := acquireAdaptiveTrial()
+	require.NotNil(t, lease)
+	finishAdaptiveTrial(lease)
+}
+
+func TestAdaptiveRetirementKeepsTrialLeaseUntilNativeClose(t *testing.T) {
+	lb, _, _, now := adaptivePolicyFixture(t, 10, 20, 30, 40)
+	c := lb.adaptive
+	for i := 0; i < 3; i++ {
+		adaptivePolicyEvidence(c, c.members[i], now.Add(-75*time.Second), 200, uint64(i*10+1))
+	}
+	c.recomputeLocked(*now)
+	c.total = 20
+	c.startTrialLocked(*now)
+	var held *adaptiveAdmission
+	for i := 0; i < 20; i++ {
+		a, err := c.admit()
+		require.NoError(t, err)
+		if a.lease != nil {
+			held = a
+		} else {
+			a.release()
+		}
+	}
+	require.NotNil(t, held)
+	lease := held.lease
+	c.retire()
+	require.Nil(t, acquireAdaptiveTrial())
+	held.fail(errors.New("old transport reset"))
+	held.release()
+	held.release()
+	require.Zero(t, lease.refs)
+	newLease := acquireAdaptiveTrial()
+	require.NotNil(t, newLease)
+	finishAdaptiveTrial(newLease)
+}
+
+func TestAdaptiveHighFanoutKeepsIndependentWindowProvenance(t *testing.T) {
+	lb, _, _, now := adaptivePolicyFixture(t, 10)
+	c, member := lb.adaptive, lb.adaptive.members[0]
+	for window := 0; window < 2; window++ {
+		at := now.Add(time.Duration(window) * 16 * time.Second)
+		for flow := 0; flow < 1024; flow++ {
+			c.addSampleLocked(member, adaptiveSample{flowID: uint64(window*1024 + flow + 1), cohort: 1, at: at, duration: time.Second, download: 100})
+		}
+		for cohort := 2; cohort < 100; cohort++ {
+			c.addSampleLocked(member, adaptiveSample{flowID: uint64(5000 + cohort), cohort: uint64(cohort), at: at, duration: time.Second, download: 100})
+		}
+	}
+	adaptiveRates(member, now.Add(17*time.Second))
+	require.True(t, member.proven)
+	require.Equal(t, 32, member.sampleCount)
+	require.InDelta(t, 100, member.mean, 0.001)
+	values := adaptiveComparisonValues(member, now.Add(-time.Second), now.Add(17*time.Second))
+	var matched int
+	for key, value := range values {
+		if key.cohort == 1 {
+			matched++
+			require.Len(t, value.flows, 2)
+			require.EqualValues(t, 102400, value.bytes)
+		}
+	}
+	require.Equal(t, 2, matched)
+}
+
+func TestAdaptiveUnsupportedCapabilitiesPreserveOriginalRouting(t *testing.T) {
+	for _, scenario := range []string{"mixed-udp", "l3"} {
+		t.Run(scenario, func(t *testing.T) {
+			lb, provider, proxies, now := adaptivePolicyFixture(t, 10, 20)
+			if scenario == "l3" {
+				proxies[0].l3 = true
+			} else {
+				proxies[0].noUDP = true
+			}
+			provider.replace([]C.Proxy{proxies[0], proxies[1]})
+			lb.adaptive.tick(now.Add(time.Second))
+			require.Equal(t, "unsupported", lb.adaptive.snapshot().State)
+			require.Empty(t, lb.adaptive.selected)
+			for _, proxy := range proxies {
+				proxy.dialErr = errors.New("original route attempted")
+			}
+			_, err := lb.DialContext(context.Background(), &C.Metadata{})
+			require.ErrorContains(t, err, "original route attempted")
+			require.Zero(t, lb.adaptive.total)
+			require.Equal(t, 1, proxies[0].dials+proxies[1].dials)
+		})
+	}
+	lb, provider, proxies, now := adaptivePolicyFixture(t, 10)
+	proxies[0].noUDP = true
+	provider.replace([]C.Proxy{proxies[0]})
+	lb.adaptive.tick(now.Add(time.Second))
+	_, err := lb.adaptive.admitNetwork(true)
+	require.ErrorIs(t, err, C.ErrNotSupport)
+	a, err := lb.adaptive.admit()
+	require.NoError(t, err)
+	a.release()
+	require.Equal(t, "active", lb.adaptive.snapshot().State)
+}
+
+func TestAdaptiveTrialPromotesAgainstCapturedBaselineWithConcurrentAnchor(t *testing.T) {
+	for _, scenario := range []string{"better", "weak", "no-anchor", "stale-reference"} {
+		t.Run(scenario, func(t *testing.T) {
+			lb, _, _, now := adaptivePolicyFixture(t, 10, 20, 30, 40)
+			c := lb.adaptive
+			started := *now
+			for i := 0; i < 3; i++ {
+				rate := uint64(300)
+				if i == 2 {
+					rate = 100
+				}
+				at := started.Add(-45 * time.Second)
+				if scenario == "stale-reference" {
+					at = started.Add(-4 * time.Minute)
+				}
+				for j := 0; j < 2; j++ {
+					c.addSampleLocked(c.members[i], adaptiveSample{flowID: uint64(i*10 + j + 1), cohort: 99, at: at.Add(time.Duration(j) * 16 * time.Second), duration: time.Second, download: rate})
+				}
+			}
+			c.recomputeLocked(started)
+			c.total = 20
+			c.startTrialLocked(started)
+			require.NotNil(t, c.trial)
+			candidate, displaced := c.trial.candidate, c.trial.displaced
+			require.Same(t, c.members[2], displaced)
+			require.NotContains(t, c.selected, displaced)
+			for j := 0; j < 2; j++ {
+				at := started.Add(time.Duration(j+1) * 16 * time.Second)
+				rate := uint64(150)
+				if scenario == "weak" {
+					rate = 105
+				}
+				c.addSampleLocked(candidate, adaptiveSample{flowID: uint64(100 + j), cohort: 99, at: at, duration: time.Second, download: rate})
+				if scenario != "no-anchor" {
+					c.addSampleLocked(c.members[0], adaptiveSample{flowID: uint64(200 + j), cohort: 99, at: at, duration: time.Second, download: 300})
+				}
+			}
+			*now = started.Add(33 * time.Second)
+			c.recomputeLocked(*now)
+			if scenario == "better" {
+				require.Nil(t, c.trial)
+				require.Contains(t, c.selected, candidate)
+				require.Equal(t, now.Add(10*time.Minute), candidate.protected)
+				require.True(t, displaced.nextChance.After(*now))
+				c.tick(now.Add(2 * time.Second))
+				require.Nil(t, c.trial, "successful promotion must not immediately retrial displaced node using stale overdue time")
+			} else {
+				require.NotNil(t, c.trial)
+				require.True(t, candidate.protected.IsZero())
+			}
+		})
+	}
+}
+
+func TestAdaptiveHealthFailureWithdrawalPreservesEscalatedCooldown(t *testing.T) {
+	for _, minutes := range []int{15, 45, 120} {
+		t.Run(fmt.Sprint(minutes), func(t *testing.T) {
+			lb, _, _, now := adaptivePolicyFixture(t, 10, 20, 30, 40)
+			c := lb.adaptive
+			for i := 0; i < 3; i++ {
+				adaptivePolicyEvidence(c, c.members[i], now.Add(-75*time.Second), 200, uint64(i*10+1))
+			}
+			c.recomputeLocked(*now)
+			c.total = 20
+			c.startTrialLocked(*now)
+			require.NotNil(t, c.trial)
+			candidate := c.trial.candidate
+			candidate.alive = false
+			candidate.cooldown = now.Add(time.Duration(minutes) * time.Minute)
+			c.pruneLocked(*now)
+			require.Nil(t, c.trial)
+			require.Equal(t, now.Add(time.Duration(minutes)*time.Minute), candidate.cooldown)
+		})
+	}
+}
+
+func TestAdaptiveNativeConfiguredHealthAndFailureExactlyOnce(t *testing.T) {
+	lb, _, proxies, _ := adaptivePolicyFixture(t, 10)
+	c := lb.adaptive
+	c.now = time.Now
+	c.checkHealth(c.members[0])
+	require.Equal(t, testUrl, proxies[0].testURL)
+	require.True(t, proxies[0].status.Check(204))
+	require.False(t, proxies[0].status.Check(200))
+	require.Nil(t, c.members[0].latency, "native zero-millisecond success is not fake 1ms")
+	proxies[0].dialErr = errors.New("dial refused")
+	_, err := lb.DialContext(context.Background(), &C.Metadata{})
+	require.Error(t, err)
+	require.Zero(t, c.members[0].failures)
+	admission := &adaptiveAdmission{controller: c, member: c.members[0]}
+	admission.fail(context.Canceled)
+	admission.fail(errors.New("first-write reset"))
+	admission.fail(errors.New("again"))
+	require.Zero(t, c.members[0].failures)
+	require.True(t, c.members[0].available(c.now()))
+	require.True(t, c.members[0].cooldown.IsZero())
+	_, err = lb.DialContext(context.Background(), &C.Metadata{Host: "other.example"})
+	require.Error(t, err)
+	require.Equal(t, 2, proxies[0].dials, "one destination refusal must not block another destination's admission")
+}
diff --git a/adapter/outboundgroup/adaptive_conn.go b/adapter/outboundgroup/adaptive_conn.go
new file mode 100644
index 0000000..317f558
--- /dev/null
+++ b/adapter/outboundgroup/adaptive_conn.go
@@ -0,0 +1,250 @@
+package outboundgroup
+
+import (
+	"context"
+	"errors"
+	"hash/maphash"
+	"io"
+	"net"
+	"os"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/metacubex/mihomo/common/buf"
+	N "github.com/metacubex/mihomo/common/net"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+var (
+	adaptiveFlowID     atomic.Uint64
+	adaptiveTargetSeed = maphash.MakeSeed()
+)
+
+type adaptiveFlow struct {
+	id       uint64
+	cohort   uint64
+	download atomic.Uint64
+	upload   atomic.Uint64
+	mu       sync.Mutex
+	last     time.Time
+}
+
+func newAdaptiveFlow(metadata *C.Metadata) *adaptiveFlow {
+	var target maphash.Hash
+	target.SetSeed(adaptiveTargetSeed)
+	if metadata != nil {
+		if metadata.Host != "" {
+			target.WriteString(strings.ToLower(strings.TrimSuffix(metadata.Host, ".")))
+		} else if metadata.DstIP.IsValid() {
+			address := metadata.DstIP.Unmap().As16()
+			target.Write(address[:])
+		}
+		target.WriteByte(byte(metadata.NetWork))
+		target.WriteByte(byte(metadata.DstPort >> 8))
+		target.WriteByte(byte(metadata.DstPort))
+	}
+	return &adaptiveFlow{id: adaptiveFlowID.Add(1), cohort: target.Sum64(), last: time.Now()}
+}
+
+func (f *adaptiveFlow) drain(now time.Time) adaptiveSample {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	sample := adaptiveSample{
+		flowID: f.id, cohort: f.cohort, at: now,
+		download: f.download.Swap(0), upload: f.upload.Swap(0),
+	}
+	if sample.download != 0 || sample.upload != 0 {
+		sample.duration = now.Sub(f.last)
+		if sample.duration > time.Second {
+			sample.duration = time.Second
+		}
+		if sample.duration <= 0 {
+			sample.duration = time.Nanosecond
+		}
+	}
+	f.last = now
+	return sample
+}
+
+func (f *adaptiveFlow) countDownload(n int64) {
+	if n > 0 {
+		f.download.Add(uint64(n))
+	}
+}
+
+func (f *adaptiveFlow) countUpload(n int64) {
+	if n > 0 {
+		f.upload.Add(uint64(n))
+	}
+}
+
+func adaptiveTransportFailure(err error) bool {
+	if err == nil || errors.Is(err, io.EOF) || errors.Is(err, context.Canceled) ||
+		errors.Is(err, context.DeadlineExceeded) || errors.Is(err, os.ErrDeadlineExceeded) ||
+		errors.Is(err, net.ErrClosed) || errors.Is(err, os.ErrClosed) {
+		return false
+	}
+	var timeout net.Error
+	return !errors.As(err, &timeout) || !timeout.Timeout()
+}
+
+// The uncounted view keeps transport errors observable after copy unwraps counters.
+type adaptiveTransportConn struct {
+	C.Conn
+	admission *adaptiveAdmission
+	closing   atomic.Bool
+}
+
+func (c *adaptiveTransportConn) observe(err error) {
+	if !c.closing.Load() && adaptiveTransportFailure(err) {
+		c.admission.fail(err)
+	}
+}
+
+func (c *adaptiveTransportConn) Read(p []byte) (int, error) {
+	n, err := c.Conn.Read(p)
+	c.observe(err)
+	return n, err
+}
+
+func (c *adaptiveTransportConn) Write(p []byte) (int, error) {
+	n, err := c.Conn.Write(p)
+	c.observe(err)
+	return n, err
+}
+
+func (c *adaptiveTransportConn) ReadBuffer(buffer *buf.Buffer) error {
+	err := c.Conn.ReadBuffer(buffer)
+	c.observe(err)
+	return err
+}
+
+func (c *adaptiveTransportConn) WriteBuffer(buffer *buf.Buffer) error {
+	err := c.Conn.WriteBuffer(buffer)
+	c.observe(err)
+	return err
+}
+
+func (c *adaptiveTransportConn) Upstream() any           { return c.Conn }
+func (c *adaptiveTransportConn) ReaderReplaceable() bool { return false }
+func (c *adaptiveTransportConn) WriterReplaceable() bool { return false }
+
+type adaptiveConn struct {
+	*adaptiveTransportConn
+	flow      *adaptiveFlow
+	closeOnce sync.Once
+	closeErr  error
+}
+
+func newAdaptiveConn(conn C.Conn, admission *adaptiveAdmission, metadata *C.Metadata) C.Conn {
+	flow := newAdaptiveFlow(metadata)
+	admission.registerFlow(flow)
+	return &adaptiveConn{
+		adaptiveTransportConn: &adaptiveTransportConn{Conn: conn, admission: admission},
+		flow:                  flow,
+	}
+}
+
+func (c *adaptiveConn) Read(p []byte) (int, error) {
+	n, err := c.adaptiveTransportConn.Read(p)
+	c.flow.countDownload(int64(n))
+	return n, err
+}
+
+func (c *adaptiveConn) Write(p []byte) (int, error) {
+	n, err := c.adaptiveTransportConn.Write(p)
+	c.flow.countUpload(int64(n))
+	return n, err
+}
+
+func (c *adaptiveConn) ReadBuffer(buffer *buf.Buffer) error {
+	err := c.adaptiveTransportConn.ReadBuffer(buffer)
+	c.flow.countDownload(int64(buffer.Len()))
+	return err
+}
+
+func (c *adaptiveConn) WriteBuffer(buffer *buf.Buffer) error {
+	n := buffer.Len()
+	err := c.adaptiveTransportConn.WriteBuffer(buffer)
+	if err == nil {
+		c.flow.countUpload(int64(n))
+	}
+	return err
+}
+
+func (c *adaptiveConn) UnwrapReader() (io.Reader, []N.CountFunc) {
+	return c.adaptiveTransportConn, []N.CountFunc{c.flow.countDownload}
+}
+
+func (c *adaptiveConn) UnwrapWriter() (io.Writer, []N.CountFunc) {
+	return c.adaptiveTransportConn, []N.CountFunc{c.flow.countUpload}
+}
+
+func (c *adaptiveConn) Close() error {
+	c.closeOnce.Do(func() {
+		c.closing.Store(true)
+		c.closeErr = c.Conn.Close()
+		c.admission.finishFlow(c.flow)
+	})
+	return c.closeErr
+}
+
+type adaptivePacketConn struct {
+	C.PacketConn
+	admission *adaptiveAdmission
+	flow      *adaptiveFlow
+	closing   atomic.Bool
+	closeOnce sync.Once
+	closeErr  error
+}
+
+func newAdaptivePacketConn(conn C.PacketConn, admission *adaptiveAdmission, metadata *C.Metadata) C.PacketConn {
+	flow := newAdaptiveFlow(metadata)
+	admission.registerFlow(flow)
+	return &adaptivePacketConn{PacketConn: conn, admission: admission, flow: flow}
+}
+
+func (c *adaptivePacketConn) observe(err error) {
+	if !c.closing.Load() && adaptiveTransportFailure(err) {
+		c.admission.fail(err)
+	}
+}
+
+func (c *adaptivePacketConn) ReadFrom(p []byte) (int, net.Addr, error) {
+	n, addr, err := c.PacketConn.ReadFrom(p)
+	c.flow.countDownload(int64(n))
+	c.observe(err)
+	return n, addr, err
+}
+
+func (c *adaptivePacketConn) WaitReadFrom() ([]byte, func(), net.Addr, error) {
+	data, put, addr, err := c.PacketConn.WaitReadFrom()
+	c.flow.countDownload(int64(len(data)))
+	c.observe(err)
+	return data, put, addr, err
+}
+
+func (c *adaptivePacketConn) WriteTo(p []byte, addr net.Addr) (int, error) {
+	n, err := c.PacketConn.WriteTo(p, addr)
+	c.flow.countUpload(int64(n))
+	c.observe(err)
+	return n, err
+}
+
+func (c *adaptivePacketConn) Upstream() any           { return c.PacketConn }
+func (c *adaptivePacketConn) ReaderReplaceable() bool { return false }
+func (c *adaptivePacketConn) WriterReplaceable() bool { return false }
+
+func (c *adaptivePacketConn) Close() error {
+	c.closeOnce.Do(func() {
+		c.closing.Store(true)
+		c.closeErr = c.PacketConn.Close()
+		c.admission.finishFlow(c.flow)
+	})
+	return c.closeErr
+}
+
+var _ C.Conn = (*adaptiveConn)(nil)
+var _ C.PacketConn = (*adaptivePacketConn)(nil)
