+func TestAdaptiveConnPartialWriteAndCloseOnce(t *testing.T) {
+	admission := adaptiveTransportTestAdmission(t)
+	closeErr := errors.New("close result")
+	underlying := &adaptiveTestConn{reader: bytes.NewReader(nil), writeLimit: 2, writeErr: io.ErrShortWrite, closeErr: closeErr}
+	conn := newAdaptiveConn(underlying, admission, nil).(*adaptiveConn)
+	n, err := conn.Write([]byte("partial"))
+	require.Equal(t, 2, n)
+	require.ErrorIs(t, err, io.ErrShortWrite)
+	require.Equal(t, uint64(2), conn.flow.upload.Load())
+	conn.flow.last = time.Now().Add(-time.Second)
+	var wg sync.WaitGroup
+	for i := 0; i < 16; i++ {
+		wg.Add(1)
+		go func() { defer wg.Done(); require.ErrorIs(t, conn.Close(), closeErr) }()
+	}
+	wg.Wait()
+	require.Equal(t, 1, underlying.closes)
+	require.Empty(t, admission.controller.flows)
+	require.Zero(t, admission.member.failures)
+	require.True(t, admission.member.alive)
+	require.True(t, admission.member.cooldown.IsZero())
+	require.Equal(t, 1, admission.member.sampleCount)
+	var upload uint64
+	for _, sample := range admission.member.samples {
+		upload += sample.upload
+	}
+	require.Equal(t, uint64(2), upload)
+}
