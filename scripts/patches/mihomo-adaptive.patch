+func TestAdaptiveConnUnwrappedHandshakeFailures(t *testing.T) {
+	for _, direction := range []string{"read", "write", "buffer-write"} {
+		t.Run(direction, func(t *testing.T) {
+			admission := adaptiveTransportTestAdmission(t)
+			underlying := &adaptiveTestConn{reader: bytes.NewReader(nil), writeLimit: -1}
+			conn := newAdaptiveConn(underlying, admission, nil).(*adaptiveConn)
+			defer conn.Close()
+			failure := errors.New("handshake rejected")
+			if direction == "read" {
+				underlying.readErr = failure
+				reader, _ := SN.UnwrapCountReader(conn, nil)
+				_, err := reader.Read(make([]byte, 8))
+				require.ErrorIs(t, err, failure)
+			} else {
+				underlying.writeErr = failure
+				underlying.writeLimit = 0
+				writer, _ := SN.UnwrapCountWriter(conn, nil)
+				if direction == "buffer-write" {
+					require.ErrorIs(t, writer.(N.ExtendedWriter).WriteBuffer(buf.As([]byte("hello"))), failure)
+				} else {
+					_, err := writer.Write([]byte("hello"))
+					require.ErrorIs(t, err, failure)
+				}
+			}
+			unobserved := false
+			admission.failed.Do(func() { unobserved = true })
+			require.False(t, unobserved, "unwrapped transport error did not reach admission")
+			require.Zero(t, admission.member.failures)
+			require.True(t, admission.member.alive)
+			require.True(t, admission.member.cooldown.IsZero())
+			require.True(t, admission.member.available(time.Now()))
+		})
+	}
+	for _, normal := range []error{io.EOF, context.Canceled, os.ErrDeadlineExceeded, net.ErrClosed} {
+		admission := adaptiveTransportTestAdmission(t)
+		underlying := &adaptiveTestConn{reader: bytes.NewReader(nil), readErr: normal, writeLimit: -1}
+		conn := newAdaptiveConn(underlying, admission, nil)
+		_, err := conn.Read(make([]byte, 8))
+		require.ErrorIs(t, err, normal)
+		require.NoError(t, conn.Close())
+		require.Zero(t, admission.member.failures)
+	}
+}
