--- /dev/null
+++ b/hub/route/cloudflare_local_windows_test.go
@@ -0,0 +1,26 @@
+//go:build windows
+
+package route
+
+import (
+	"context"
+	"net"
+	"path/filepath"
+	"testing"
+
+	"github.com/metacubex/mihomo/adapter/inbound"
+	"github.com/tailscale/go-winio"
+)
+
+func TestCloudflareNamedPipeAuthentication(t *testing.T) {
+	testCloudflareLocalAuthentication(t, func(t *testing.T) (net.Listener, func(context.Context, string, string) (net.Conn, error)) {
+		path := `\\.\pipe\mihomo-cloudflare-auth-test-` + filepath.Base(filepath.Dir(t.TempDir()))
+		listener, err := inbound.ListenNamedPipe(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return listener, func(ctx context.Context, _, _ string) (net.Conn, error) {
+			return winio.DialPipeContext(ctx, path)
+		}
+	})
+}
