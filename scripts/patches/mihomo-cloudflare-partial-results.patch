+func TestTransientRetryClassification(t *testing.T) {
+	for _, tc := range []struct {
+		err  error
+		want bool
+	}{
+		{&net.OpError{Op: "dial", Err: syscall.ECONNREFUSED}, true},
+		{errors.Join(errors.New("safe connect failure"), &net.OpError{Op: "dial", Err: syscall.ETIMEDOUT}), true},
+		{io.ErrUnexpectedEOF, true},
+		{&tls.CertificateVerificationError{Err: x509.UnknownAuthorityError{}}, false},
+		{x509.HostnameError{}, false},
+		{errors.New("physical interface binding failed"), false},
+		{context.Canceled, false},
+	} {
+		if got := transientError(tc.err); got != tc.want {
+			t.Errorf("retryable %T=%v, want %v", tc.err, got, tc.want)
+		}
+	}
+}
