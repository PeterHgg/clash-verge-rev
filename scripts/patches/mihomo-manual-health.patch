diff --git a/adapter/outboundgroup/manual_health_test.go b/adapter/outboundgroup/manual_health_test.go
new file mode 100644
index 0000000..5800df1
--- /dev/null
+++ b/adapter/outboundgroup/manual_health_test.go
@@ -0,0 +1,146 @@
+package outboundgroup
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/adapter"
+	"github.com/metacubex/mihomo/adapter/outbound"
+	"github.com/metacubex/mihomo/common/utils"
+	C "github.com/metacubex/mihomo/constant"
+	P "github.com/metacubex/mihomo/constant/provider"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestManualHealthCheckKeepsManualTestsWithoutAutomaticChecks(t *testing.T) {
+	for _, manual := range []bool{false, true} {
+		t.Run(fmt.Sprintf("manual=%t", manual), func(t *testing.T) {
+			var requests atomic.Int32
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				requests.Add(1)
+				w.WriteHeader(http.StatusNoContent)
+			}))
+			defer server.Close()
+			proxy := adapter.NewProxy(outbound.NewDirect())
+			providers := map[string]P.ProxyProvider{}
+			group, err := ParseProxyGroup(map[string]any{
+				"name": "lb", "type": "load-balance", "proxies": []string{"DIRECT"},
+				"url": server.URL, "interval": 1, "lazy": false, "manual-health-check": manual,
+			}, map[string]C.Proxy{"DIRECT": proxy, "COMPATIBLE": proxy}, providers, nil, nil)
+			require.NoError(t, err)
+			pd := providers["lb"]
+			defer pd.(interface{ Close() error }).Close()
+			require.NoError(t, pd.Initial())
+			if manual {
+				time.Sleep(1200 * time.Millisecond)
+				require.Zero(t, requests.Load())
+				require.Empty(t, pd.HealthCheckURL())
+				pd.HealthCheck()
+				require.Zero(t, requests.Load())
+				lb := group.(*LoadBalance)
+				require.Equal(t, server.URL, lb.testUrl)
+				lb.onDialFailed(C.Shadowsocks, errors.New("connection refused"), lb.healthCheck)
+				time.Sleep(100 * time.Millisecond)
+				require.Zero(t, requests.Load())
+				_, err = group.URLTest(context.Background(), server.URL, nil)
+				require.NoError(t, err)
+				require.EqualValues(t, 1, requests.Load())
+			} else {
+				require.Eventually(t, func() bool { return requests.Load() >= 2 }, 3*time.Second, 10*time.Millisecond)
+				require.Equal(t, server.URL, pd.HealthCheckURL())
+			}
+		})
+	}
+}
+
+func TestManualHealthCheckSuppressesFailureCallback(t *testing.T) {
+	for _, manual := range []bool{false, true} {
+		group := NewGroupBase(GroupBaseOption{Name: "lb", ManualHealthCheck: manual})
+		called := make(chan struct{}, 1)
+		group.onDialFailed(C.Shadowsocks, errors.New("connection refused"), func() { called <- struct{}{} })
+		select {
+		case <-called:
+			require.False(t, manual)
+		case <-time.After(time.Second):
+			require.True(t, manual)
+		}
+	}
+}
+
+type healthRegistrationSpy struct {
+	P.ProxyProvider
+	registrations int
+}
+
+func (p *healthRegistrationSpy) VehicleType() P.VehicleType { return P.Inline }
+func (p *healthRegistrationSpy) RegisterHealthCheckTask(string, utils.IntRanges[uint16], string, uint) {
+	p.registrations++
+}
+
+func TestManualHealthCheckDoesNotRegisterProviderTasks(t *testing.T) {
+	for _, manual := range []bool{false, true} {
+		proxy := adapter.NewProxy(outbound.NewDirect())
+		pd := &healthRegistrationSpy{}
+		_, err := ParseProxyGroup(map[string]any{
+			"name": "lb", "type": "load-balance", "use": []string{"source"},
+			"url": testUrl, "interval": 1, "manual-health-check": manual,
+		}, map[string]C.Proxy{"COMPATIBLE": proxy}, map[string]P.ProxyProvider{"source": pd}, nil, nil)
+		require.NoError(t, err)
+		if manual {
+			require.Zero(t, pd.registrations)
+		} else {
+			require.Equal(t, 1, pd.registrations)
+		}
+	}
+}
+
+func TestManualTwentySlotRoundRobinAdmission(t *testing.T) {
+	proxyMap := map[string]C.Proxy{}
+	for _, name := range []string{"a", "b", "c", "COMPATIBLE"} {
+		proxyMap[name] = adapter.NewProxy(outbound.NewDirectWithOption(outbound.DirectOption{Name: name}))
+	}
+	providers := map[string]P.ProxyProvider{}
+	var names []string
+	for i := 0; i < 20; i++ {
+		name := fmt.Sprintf("slot-%d", i)
+		group, err := ParseProxyGroup(map[string]any{
+			"name": name, "type": "select", "proxies": []string{"a", "b", "c"},
+			"url": testUrl, "manual-health-check": true,
+		}, proxyMap, providers, nil, nil)
+		require.NoError(t, err)
+		proxyMap[name] = adapter.NewProxy(group)
+		names = append(names, name)
+		defer providers[name].(interface{ Close() error }).Close()
+	}
+	parent, err := ParseProxyGroup(map[string]any{
+		"name": "lb", "type": "load-balance", "strategy": "round-robin", "proxies": names,
+		"url": testUrl, "manual-health-check": true,
+	}, proxyMap, providers, nil, nil)
+	require.NoError(t, err)
+	defer providers["lb"].(interface{ Close() error }).Close()
+	lb := parent.(*LoadBalance)
+	for _, shares := range [][3]int{{7, 7, 6}, {10, 9, 1}} {
+		i := 0
+		for member, count := range shares {
+			for j := 0; j < count; j++ {
+				require.NoError(t, proxyMap[names[i]].Adapter().(*Selector).Set([]string{"a", "b", "c"}[member]))
+				i++
+			}
+		}
+		counts := map[string]int{}
+		for j := 0; j < 200; j++ {
+			selected := lb.strategyFn(lb.GetProxies(false), nil, true)
+			counts[selected.Adapter().(*Selector).Now()]++
+		}
+		for member, name := range []string{"a", "b", "c"} {
+			require.Equal(t, shares[member]*10, counts[name])
+		}
+	}
+}
